      "type": "main-page",
      "settings": {
        "show_breadcrumbs": true,
        "show_title": true,
        "show_content": true,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "hero": {
      "type": "image-banner",
      "disabled": true,
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "Supporting heading",
            "heading_tag": "h2",
            "heading_size": "h1"
          }
        },
        "text": {
