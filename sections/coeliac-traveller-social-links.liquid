{% comment %}
  Coeliac Traveller
{% endcomment %}
{{ 'coeliac-traveller.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="coeliac-traveller coeliac-traveller__section section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="coeliac-traveller__panel coeliac-traveller__social-panel">
      <div class="coeliac-traveller__section-header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="coeliac-traveller__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="coeliac-traveller__heading coeliac-traveller__heading--medium">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.body != blank -%}
          <div class="coeliac-traveller__body rte">{{ section.settings.body }}</div>
        {%- endif -%}
      </div>

      <div class="coeliac-traveller__social-list">
        {%- for block in section.blocks -%}
          {%- assign icon_text = block.settings.label | strip | slice: 0, 2 | upcase -%}
          <a class="coeliac-traveller__social-link" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
            <span class="coeliac-traveller__social-icon">{{ icon_text }}</span>
            <span>{{ block.settings.label }}</span>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CT social links",
  "tag": "section",
  "class": "section section-coeliac-traveller-social-links",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Stay connected"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Follow the journey"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>Add your social channels here as clean branded buttons. You can swap these links later without affecting the rest of the theme.</p>"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "social",
      "name": "Social link",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Instagram"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Coeliac Traveller social links",
      "blocks": [
        {
          "type": "social",
          "settings": {
            "label": "Instagram"
          }
        },
        {
          "type": "social",
          "settings": {
            "label": "TikTok"
          }
        },
        {
          "type": "social",
          "settings": {
            "label": "Facebook"
          }
        }
      ]
    }
  ]
}
{% endschema %}
