{{ 'section-hub-page.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign summary_field = page.metafields.custom.summary
  assign summary = summary_field.value
  assign hero_image = page.metafields.custom.hero_image.value
  assign eyebrow = page.metafields.custom.eyebrow.value | default: section.settings.default_eyebrow
  assign child_pages = page.metafields.custom.child_pages.value | default: page.metafields.custom.ship_pages.value | default: page.metafields.custom.related_pages.value
  assign primary_cta_label = page.metafields.custom.primary_cta_label.value
  assign primary_cta_link = page.metafields.custom.primary_cta_link.value
  assign secondary_cta_label = page.metafields.custom.secondary_cta_label.value
  assign secondary_cta_link = page.metafields.custom.secondary_cta_link.value
  assign cta_heading = page.metafields.custom.bottom_cta_heading.value
  assign cta_text_field = page.metafields.custom.bottom_cta_text
  assign cta_text = cta_text_field.value
  assign cta_label = page.metafields.custom.bottom_cta_label.value
  assign cta_link = page.metafields.custom.bottom_cta_link.value
  assign current_url = request.origin | append: page.url
  assign parent_title = blank
  assign parent_url = blank
  assign child_menu = linklists[section.settings.child_menu]

  if section.settings.parent_page != blank and pages[section.settings.parent_page] != blank
    assign parent_title = pages[section.settings.parent_page].title
    assign parent_url = request.origin | append: pages[section.settings.parent_page].url
  endif

  capture sanitized_primary_cta_link
    render 'sanitize-url', url: primary_cta_link
  endcapture

  capture sanitized_secondary_cta_link
    render 'sanitize-url', url: secondary_cta_link
  endcapture

  capture sanitized_cta_link
    render 'sanitize-url', url: cta_link
  endcapture
-%}

<section class="hub-page page-width section-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  {% render 'breadcrumbs',
    current_title: page.title,
    current_url: current_url,
    parent_title: parent_title,
    parent_url: parent_url
  %}

  <div class="hub-page__hero">
    <div class="hub-page__hero-copy">
      {%- if eyebrow != blank -%}
        <p class="hub-page__eyebrow">{{ eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="hub-page__title h0">{{ page.title | escape }}</h1>
      {%- if summary != blank -%}
        <div class="hub-page__summary rte">
          {%- if summary_field.type == 'rich_text_field' -%}
            {{ summary_field | metafield_tag }}
          {%- else -%}
            {{ summary | newline_to_br }}
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- if sanitized_primary_cta_link != blank or sanitized_secondary_cta_link != blank -%}
        <div class="hub-page__actions">
          {%- if primary_cta_label != blank and sanitized_primary_cta_link != blank -%}
            <a class="button" href="{{ sanitized_primary_cta_link }}">{{ primary_cta_label | escape }}</a>
          {%- endif -%}
          {%- if secondary_cta_label != blank and sanitized_secondary_cta_link != blank -%}
            <a class="button button--secondary" href="{{ sanitized_secondary_cta_link }}">{{ secondary_cta_label | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="hub-page__hero-media media">
      {%- if hero_image != blank -%}
        {{
          hero_image
          | image_url: width: 2200
          | image_tag:
            widths: '375, 550, 750, 1100, 1500, 1780, 2200',
            sizes: '(min-width: 750px) 55vw, 100vw',
            loading: 'eager',
            fetchpriority: 'high'
        }}
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
  </div>

  {%- if page.content != blank -%}
    <div class="hub-page__section">
      <div class="hub-page__intro">
        <div class="rte">{{ page.content }}</div>
      </div>
    </div>
  {%- endif -%}

  {%- if child_pages != blank or child_menu.links != blank -%}
    <div class="hub-page__section">
      <h2 class="hub-page__section-title h1">{{ section.settings.children_heading }}</h2>
      <div class="hub-page__items">
        {%- if child_pages != blank -%}
          {%- for child_page in child_pages limit: section.settings.children_limit -%}
            <article class="hub-page__item-card">
              <a class="hub-page__item-link" href="{{ child_page.url }}">
                <div class="hub-page__item-media media">
                  {%- if child_page.metafields.custom.hero_image.value != blank -%}
                    {{
                      child_page.metafields.custom.hero_image.value
                      | image_url: width: 1200
                      | image_tag:
                        widths: '320, 480, 720, 960, 1200',
                        sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                        loading: 'lazy'
                    }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
                <div class="hub-page__item-body">
                  <h3 class="h3">{{ child_page.title | escape }}</h3>
                  {%- if child_page.metafields.custom.summary.value != blank -%}
                    <p>{{ child_page.metafields.custom.summary.value | strip_html | truncatewords: 20 }}</p>
                  {%- elsif child_page.content != blank -%}
                    <p>{{ child_page.content | strip_html | truncatewords: 20 }}</p>
                  {%- endif -%}
                </div>
              </a>
            </article>
          {%- endfor -%}
        {%- else -%}
          {%- assign child_count = 0 -%}
          {%- for child_link in child_menu.links -%}
            {%- if child_count < section.settings.children_limit -%}
              <article class="hub-page__item-card">
                <a class="hub-page__item-link" href="{{ child_link.url }}">
                  <div class="hub-page__item-body">
                    <h3 class="h3">{{ child_link.title | escape }}</h3>
                  </div>
                </a>
              </article>
              {%- assign child_count = child_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- if cta_heading != blank or cta_text != blank or sanitized_cta_link != blank -%}
    <div class="hub-page__section">
      <div class="hub-page__cta">
        {%- if cta_heading != blank -%}
          <h2 class="h2">{{ cta_heading | escape }}</h2>
        {%- endif -%}
        {%- if cta_text != blank -%}
          <div class="rte">
            {%- if cta_text_field.type == 'rich_text_field' -%}
              {{ cta_text_field | metafield_tag }}
            {%- else -%}
              {{ cta_text | newline_to_br }}
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if cta_label != blank and sanitized_cta_link != blank -%}
          <a class="button" href="{{ sanitized_cta_link }}">{{ cta_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hub page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "page",
      "id": "parent_page",
      "label": "Parent page"
    },
    {
      "type": "text",
      "id": "default_eyebrow",
      "label": "Default eyebrow",
      "default": "Overview"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "children_heading",
      "label": "Children heading",
      "default": "Explore more"
    },
    {
      "type": "link_list",
      "id": "child_menu",
      "label": "Children menu fallback"
    },
    {
      "type": "range",
      "id": "children_limit",
      "label": "Children limit",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Hub page"
    }
  ]
}
{% endschema %}
