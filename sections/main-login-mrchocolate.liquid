{{ 'customer.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .mrchocolate-login {
    max-width: 112rem;
    margin: 0 auto;
    display: grid;
    gap: 2.4rem;
  }

  .mrchocolate-login__hero {
    display: grid;
    gap: 2.4rem;
    padding: 2.4rem;
    border-radius: 2.4rem;
    background:
      radial-gradient(circle at top left, rgba(177, 98, 43, 0.16), transparent 38%),
      linear-gradient(135deg, #1d120d 0%, #342018 100%);
    color: #f8efe8;
  }

  .mrchocolate-login__eyebrow {
    margin: 0;
    font-size: 1.2rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.78;
  }

  .mrchocolate-login__title {
    margin: 0.6rem 0 0;
    font-size: clamp(3rem, 5vw, 5.2rem);
    line-height: 1;
  }

  .mrchocolate-login__copy {
    max-width: 62rem;
    font-size: 1.6rem;
    line-height: 1.6;
    opacity: 0.9;
  }

  .mrchocolate-login__points {
    display: grid;
    gap: 1.2rem;
  }

  .mrchocolate-login__point {
    padding: 1.4rem 1.6rem;
    border: 0.1rem solid rgba(248, 239, 232, 0.12);
    border-radius: 1.6rem;
    background: rgba(255, 255, 255, 0.04);
  }

  .mrchocolate-login__point strong {
    display: block;
    margin-bottom: 0.4rem;
    color: #fff7f1;
  }

  .mrchocolate-login__card {
    padding: 2.4rem;
    border-radius: 2.4rem;
    background: rgb(var(--color-background));
    border: 0.1rem solid rgba(var(--color-foreground), 0.08);
    box-shadow: 0 2rem 5rem rgba(24, 16, 10, 0.08);
  }

  .mrchocolate-login__section-title {
    margin: 0 0 1.2rem;
    font-size: 2.2rem;
  }

  .mrchocolate-login__section-copy {
    margin: 0 0 2rem;
    font-size: 1.5rem;
    line-height: 1.6;
    opacity: 0.8;
  }

  .mrchocolate-login__stack {
    display: grid;
    gap: 2rem;
  }

  .mrchocolate-login__actions {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .mrchocolate-login__divider {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 1.6rem 0;
    color: rgba(var(--color-foreground), 0.5);
    font-size: 1.3rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .mrchocolate-login__divider::before,
  .mrchocolate-login__divider::after {
    content: '';
    height: 0.1rem;
    flex: 1;
    background: rgba(var(--color-foreground), 0.12);
  }

  .mrchocolate-login .field + .field {
    margin-top: 1.6rem;
  }

  .mrchocolate-login .button,
  .mrchocolate-login button {
    min-width: 18rem;
  }

  .mrchocolate-login__footnote {
    font-size: 1.3rem;
    opacity: 0.72;
  }

  @media screen and (min-width: 990px) {
    .mrchocolate-login {
      grid-template-columns: minmax(0, 1.1fr) minmax(42rem, 0.9fr);
      align-items: start;
    }

    .mrchocolate-login__hero {
      min-height: 100%;
      padding: 3.2rem;
    }

    .mrchocolate-login__card {
      padding: 3.2rem;
    }
  }
{%- endstyle -%}

{%- if section.settings.enable_shop_login_button == false -%}
  {%- assign hide_shop_login_button = true -%}
{%- endif -%}

<div class="customer section-{{ section.id }}-padding">
  <div class="mrchocolate-login">
    <section class="mrchocolate-login__hero" aria-labelledby="MrChocolateAccountsHeading">
      <div>
        <p class="mrchocolate-login__eyebrow">{{ section.settings.eyebrow }}</p>
        <h1 id="MrChocolateAccountsHeading" class="mrchocolate-login__title">{{ section.settings.heading }}</h1>
      </div>

      <div class="mrchocolate-login__copy">
        <p>{{ section.settings.intro }}</p>
      </div>

      <div class="mrchocolate-login__points">
        <div class="mrchocolate-login__point">
          <strong>Travel customers</strong>
          <span>Access trip notes, hotel details, support details, and planning updates.</span>
        </div>
        <div class="mrchocolate-login__point">
          <strong>Ticket customers</strong>
          <span>Access ticket information, key dates, booking notes, and delivery links.</span>
        </div>
        <div class="mrchocolate-login__point">
          <strong>Future-ready</strong>
          <span>This login can stay in place while account data later comes from Salesforce.</span>
        </div>
      </div>
    </section>

    <section class="mrchocolate-login__card" aria-labelledby="CustomerLoginHeading">
      <div id="recover" tabindex="-1">
        <h2 class="mrchocolate-login__section-title">{{ section.settings.recover_heading }}</h2>
        <p class="mrchocolate-login__section-copy">{{ section.settings.recover_copy }}</p>

        {%- form 'recover_customer_password' -%}
          {% assign recover_success = form.posted_successfully? %}

          <div class="field">
            <input
              type="email"
              value=""
              name="email"
              id="RecoverEmail"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="RecoverEmail-email-error"
                autofocus
              {% endif %}
              placeholder="{{ 'customer.login_page.email' | t }}"
            >
            <label for="RecoverEmail">{{ 'customer.login_page.email' | t }}</label>
          </div>

          {%- if form.errors -%}
            <small id="RecoverEmail-email-error" class="form__message">
              <span class="svg-wrapper">
                {{- 'icon-error.svg' | inline_asset_content -}}
              </span>
              {{ form.errors.messages.form }}
            </small>
          {%- endif -%}

          <div class="mrchocolate-login__actions">
            <button>{{ section.settings.recover_button_label }}</button>
            <a href="#login">{{ section.settings.back_to_login_label }}</a>
          </div>
        {%- endform -%}
      </div>

      <div id="login" tabindex="-1" class="mrchocolate-login__stack">
        <div>
          <h2 id="CustomerLoginHeading" class="mrchocolate-login__section-title">{{ section.settings.login_heading }}</h2>
          <p class="mrchocolate-login__section-copy">{{ section.settings.login_copy }}</p>
        </div>

        {%- if recover_success == true -%}
          <h3 class="form__message" tabindex="-1" autofocus>
            <span class="svg-wrapper">
              {{- 'icon-success.svg' | inline_asset_content -}}
            </span>
            {{ 'customer.recover_password.success' | t }}
          </h3>
        {%- endif -%}

        {%- form 'customer_login', novalidate: 'novalidate' -%}
          {%- if form.errors -%}
            <h3 class="form__message" tabindex="-1" autofocus>
              <span class="visually-hidden">{{ 'accessibility.error' | t }} </span>
              <span class="svg-wrapper">
                {{- 'icon-error.svg' | inline_asset_content -}}
              </span>
              {{ 'templates.contact.form.error_heading' | t }}
            </h3>
            {{ form.errors | default_errors }}
          {%- endif -%}

          {%- if shop.features.login_with_shop_classic_customer_accounts? -%}
            <section name="sign-in-with-shop-provider">
              {{ shop | login_button: hide_button: hide_shop_login_button }}

              {%- unless hide_shop_login_button -%}
                <div class="mrchocolate-login__divider">or use email</div>
              {%- endunless -%}
            </section>
          {%- endif -%}

          <div class="field">
            <input
              type="email"
              name="customer[email]"
              id="CustomerEmail"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              {% if form.errors contains 'form' %}
                aria-invalid="true"
              {% endif %}
              placeholder="{{ 'customer.login_page.email' | t }}"
            >
            <label for="CustomerEmail">{{ 'customer.login_page.email' | t }}</label>
          </div>

          {%- if form.password_needed -%}
            <div class="field">
              <input
                type="password"
                value=""
                name="customer[password]"
                id="CustomerPassword"
                autocomplete="current-password"
                {% if form.errors contains 'form' %}
                  aria-invalid="true"
                {% endif %}
                placeholder="{{ 'customer.login_page.password' | t }}"
              >
              <label for="CustomerPassword">{{ 'customer.login_page.password' | t }}</label>
            </div>
          {%- endif -%}

          <div class="mrchocolate-login__actions">
            <button>{{ section.settings.login_button_label }}</button>
            {%- if form.password_needed -%}
              <a href="#recover">{{ 'customer.login_page.forgot_password' | t }}</a>
            {%- endif -%}
            <a href="{{ routes.account_register_url }}">{{ section.settings.create_account_label }}</a>
          </div>
        {%- endform -%}

        <p class="mrchocolate-login__footnote">
          {{ section.settings.footnote }}
        </p>

        {%- if shop.checkout.guest_login -%}
          <div class="mrchocolate-login__divider">guest checkout</div>
          {%- form 'guest_login' -%}
            <button>{{ 'customer.login_page.guest_continue' | t }}</button>
          {%- endform -%}
        {%- endif -%}
      </div>
    </section>
  </div>
</div>

{% schema %}
{
  "name": "MrChocolate Login",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "MrChocolate Accounts"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sign in to your customer portal"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro copy",
      "default": "Use your MrChocolate customer account to access your travel or ticket details. This is a custom-branded login experience built on Shopify now and ready for Salesforce-fed account data later."
    },
    {
      "type": "text",
      "id": "login_heading",
      "label": "Login heading",
      "default": "Account login"
    },
    {
      "type": "textarea",
      "id": "login_copy",
      "label": "Login copy",
      "default": "Only logged-in customers can access portal content. If your account has already been set up, sign in below."
    },
    {
      "type": "text",
      "id": "login_button_label",
      "label": "Login button label",
      "default": "Sign in"
    },
    {
      "type": "text",
      "id": "create_account_label",
      "label": "Create account label",
      "default": "Create account"
    },
    {
      "type": "text",
      "id": "recover_heading",
      "label": "Recover heading",
      "default": "Reset your password"
    },
    {
      "type": "textarea",
      "id": "recover_copy",
      "label": "Recover copy",
      "default": "Enter your account email and we will send a reset link."
    },
    {
      "type": "text",
      "id": "recover_button_label",
      "label": "Recover button label",
      "default": "Send reset link"
    },
    {
      "type": "text",
      "id": "back_to_login_label",
      "label": "Back to login label",
      "default": "Back to sign in"
    },
    {
      "type": "textarea",
      "id": "footnote",
      "label": "Footnote",
      "default": "Phase 1 uses Shopify customer authentication. Customer data can later be mapped from Salesforce without replacing this front-end experience."
    },
    {
      "type": "checkbox",
      "id": "enable_shop_login_button",
      "label": "Enable Shop login button",
      "default": true
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ]
}
{% endschema %}
