{{ 'section-detail-page.css' | asset_url | stylesheet_tag }}
{{ 'section-page-context-nav.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign summary_field = page.metafields.custom.summary
  assign hero_image = page.metafields.custom.hero_image.value
  assign eyebrow = page.metafields.custom.eyebrow.value | default: section.settings.default_eyebrow
  assign summary = summary_field.value
  assign feature_entries = page.metafields.custom.features.value | default: page.metafields.custom.cruise_features.value
  assign primary_cta_label = page.metafields.custom.primary_cta_label.value
  assign primary_cta_link = page.metafields.custom.primary_cta_link.value
  assign secondary_cta_label = page.metafields.custom.secondary_cta_label.value
  assign secondary_cta_link = page.metafields.custom.secondary_cta_link.value
  assign feature_1_title = page.metafields.custom.feature_1_title.value
  assign feature_1_text = page.metafields.custom.feature_1_text.value
  assign feature_2_title = page.metafields.custom.feature_2_title.value
  assign feature_2_text = page.metafields.custom.feature_2_text.value
  assign feature_3_title = page.metafields.custom.feature_3_title.value
  assign feature_3_text = page.metafields.custom.feature_3_text.value
  assign related_pages = page.metafields.custom.related_pages.value
  assign cta_heading = page.metafields.custom.bottom_cta_heading.value
  assign cta_text_field = page.metafields.custom.bottom_cta_text
  assign cta_text = cta_text_field.value
  assign cta_label = page.metafields.custom.bottom_cta_label.value
  assign cta_link = page.metafields.custom.bottom_cta_link.value
  assign current_url = request.origin | append: page.url
  assign parent_page_object = blank
  assign related_menu = linklists[section.settings.related_menu]
  assign fallback_feature_count = 0

  if feature_1_title != blank
    assign fallback_feature_count = fallback_feature_count | plus: 1
  endif
  if feature_2_title != blank
    assign fallback_feature_count = fallback_feature_count | plus: 1
  endif
  if feature_3_title != blank
    assign fallback_feature_count = fallback_feature_count | plus: 1
  endif

  if section.settings.parent_page != blank and pages[section.settings.parent_page] != blank
    assign parent_page_object = pages[section.settings.parent_page]
  endif

  capture sanitized_primary_cta_link
    render 'sanitize-url', url: primary_cta_link
  endcapture

  capture sanitized_secondary_cta_link
    render 'sanitize-url', url: secondary_cta_link
  endcapture

  capture sanitized_cta_link
    render 'sanitize-url', url: cta_link
  endcapture
-%}

<section class="detail-page page-width section-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  {% render 'breadcrumbs',
    page_object: page,
    parent_page: parent_page_object,
    current_title: page.title,
    current_url: current_url,
  %}

  <div class="detail-page__hero">
    <div class="detail-page__media media">
      {%- if hero_image != blank -%}
        {{
          hero_image
          | image_url: width: 2000
          | image_tag:
            widths: '375, 550, 750, 1100, 1500, 1780, 2000',
            sizes: '(min-width: 750px) 60vw, 100vw',
            loading: 'eager',
            fetchpriority: 'high'
        }}
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>

    <div class="detail-page__content">
      {%- if eyebrow != blank -%}
        <p class="detail-page__eyebrow">{{ eyebrow | escape }}</p>
      {%- endif -%}

      <h1 class="detail-page__title h0">{{ page.title | escape }}</h1>

      {%- if summary != blank -%}
        <div class="detail-page__summary rte">
          {%- if summary_field.type == 'rich_text_field' -%}
            {{ summary_field | metafield_tag }}
          {%- else -%}
            {{ summary | newline_to_br }}
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if sanitized_primary_cta_link != blank or sanitized_secondary_cta_link != blank -%}
        <div class="detail-page__actions">
          {%- if primary_cta_label != blank and sanitized_primary_cta_link != blank -%}
            <a class="button" href="{{ sanitized_primary_cta_link }}">{{ primary_cta_label | escape }}</a>
          {%- endif -%}
          {%- if secondary_cta_label != blank and sanitized_secondary_cta_link != blank -%}
            <a class="button button--secondary" href="{{ sanitized_secondary_cta_link }}">{{ secondary_cta_label | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {% render 'page-context-nav',
    page_object: page,
    mode: 'detail',
    parent_page: parent_page_object,
    related_pages: related_pages,
    menu_handle: section.settings.related_menu,
    back_prefix: section.settings.context_back_prefix,
    primary_heading: section.settings.context_section_heading,
    secondary_heading: section.settings.context_related_heading,
    primary_limit: section.settings.context_section_limit,
    secondary_limit: section.settings.context_related_limit
  %}

  {%- if page.content != blank -%}
    <div class="detail-page__body">
      <div class="detail-page__body-card rte">
        {{ page.content }}
      </div>
    </div>
  {%- endif -%}

  {%- if feature_entries != blank or fallback_feature_count > 0 -%}
    <div class="detail-page__section">
      <h2 class="detail-page__section-title h2">{{ section.settings.highlights_heading }}</h2>
      <div class="detail-page__grid">
        {%- if feature_entries != blank -%}
          {%- for feature in feature_entries -%}
            {%- liquid
              assign feature_title = feature.title.value | default: feature.heading.value
              assign feature_image = feature.image.value
              assign feature_link_label = feature.link_label.value | default: feature.button_label.value
              assign raw_feature_link = feature.link_url.value | default: feature.button_link.value

              if raw_feature_link == blank and feature.page.value != blank
                assign raw_feature_link = feature.page.value.url
              endif

              capture feature_link
                render 'sanitize-url', url: raw_feature_link
              endcapture
            -%}
            <article class="detail-page__card">
              {%- if feature_image != blank -%}
                <div class="detail-page__card-media media">
                  {{
                    feature_image
                    | image_url: width: 1200
                    | image_tag:
                      widths: '320, 480, 720, 960, 1200',
                      sizes: '(min-width: 750px) 33vw, 100vw',
                      loading: 'lazy'
                  }}
                </div>
              {%- endif -%}
              <div class="detail-page__card-content">
                {%- if feature_title != blank -%}
                  <h3 class="h4">{{ feature_title | escape }}</h3>
                {%- endif -%}
                {%- if feature.text != blank -%}
                  <div class="rte">{{ feature.text | metafield_tag }}</div>
                {%- elsif feature.description != blank -%}
                  <div class="rte">{{ feature.description | metafield_tag }}</div>
                {%- elsif feature.body != blank -%}
                  <div class="rte">{{ feature.body | metafield_tag }}</div>
                {%- endif -%}
                {%- if feature_link != blank -%}
                  <a class="link animate-arrow" href="{{ feature_link }}">
                    {{ feature_link_label | default: 'Learn more' | escape }}
                    <span class="svg-wrapper"
                      ><span class="icon-wrap">&nbsp;{{ 'icon-arrow.svg' | inline_asset_content }}</span></span
                    >
                  </a>
                {%- endif -%}
              </div>
            </article>
          {%- endfor -%}
        {%- else -%}
          {%- if feature_1_title != blank -%}
            <article class="detail-page__card">
              <div class="detail-page__card-content">
                <h3 class="h4">{{ feature_1_title | escape }}</h3>
                {%- if feature_1_text != blank -%}<div class="rte">{{ feature_1_text | newline_to_br }}</div>{%- endif -%}
              </div>
            </article>
          {%- endif -%}
          {%- if feature_2_title != blank -%}
            <article class="detail-page__card">
              <div class="detail-page__card-content">
                <h3 class="h4">{{ feature_2_title | escape }}</h3>
                {%- if feature_2_text != blank -%}<div class="rte">{{ feature_2_text | newline_to_br }}</div>{%- endif -%}
              </div>
            </article>
          {%- endif -%}
          {%- if feature_3_title != blank -%}
            <article class="detail-page__card">
              <div class="detail-page__card-content">
                <h3 class="h4">{{ feature_3_title | escape }}</h3>
                {%- if feature_3_text != blank -%}<div class="rte">{{ feature_3_text | newline_to_br }}</div>{%- endif -%}
              </div>
            </article>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- if related_pages != blank or related_menu.links != blank -%}
    <div class="detail-page__section">
      <h2 class="detail-page__section-title h2">{{ section.settings.related_heading }}</h2>
      <ul class="detail-page__related-list">
        {%- if related_pages != blank -%}
          {%- for related_page in related_pages limit: section.settings.related_limit -%}
            <li class="detail-page__related-item">
              <a class="detail-page__related-link" href="{{ related_page.url }}">
                <strong>{{ related_page.title | escape }}</strong>
                {%- if related_page.content != blank -%}
                  <span>{{ related_page.content | strip_html | truncatewords: 18 }}</span>
                {%- endif -%}
              </a>
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- assign related_count = 0 -%}
          {%- for related_link in related_menu.links -%}
            {%- if related_link.url != page.url and related_count < section.settings.related_limit -%}
              <li class="detail-page__related-item">
                <a class="detail-page__related-link" href="{{ related_link.url }}">
                  <strong>{{ related_link.title | escape }}</strong>
                </a>
              </li>
              {%- assign related_count = related_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </div>
  {%- endif -%}

  {%- if cta_heading != blank or cta_text != blank or sanitized_cta_link != blank -%}
    <div class="detail-page__section">
      <div class="detail-page__cta">
        {%- if cta_heading != blank -%}
          <h2 class="h2">{{ cta_heading | escape }}</h2>
        {%- endif -%}
        {%- if cta_text != blank -%}
          <div class="rte">
            {%- if cta_text_field.type == 'rich_text_field' -%}
              {{ cta_text_field | metafield_tag }}
            {%- else -%}
              {{ cta_text | newline_to_br }}
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if cta_label != blank and sanitized_cta_link != blank -%}
          <a class="button" href="{{ sanitized_cta_link }}">{{ cta_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Detail page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "page",
      "id": "parent_page",
      "label": "Parent page"
    },
    {
      "type": "text",
      "id": "default_eyebrow",
      "label": "Default eyebrow",
      "default": "Overview"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "highlights_heading",
      "label": "Highlights heading",
      "default": "Highlights"
    },
    {
      "type": "header",
      "content": "Context navigation"
    },
    {
      "type": "text",
      "id": "context_back_prefix",
      "label": "Back link prefix",
      "default": "Back to"
    },
    {
      "type": "text",
      "id": "context_section_heading",
      "label": "Section links heading",
      "default": "More in this section"
    },
    {
      "type": "text",
      "id": "context_related_heading",
      "label": "Context related heading",
      "default": "Related guides"
    },
    {
      "type": "range",
      "id": "context_section_limit",
      "label": "Section links limit",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "context_related_limit",
      "label": "Context related limit",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "related_heading",
      "label": "Related pages heading",
      "default": "Related pages"
    },
    {
      "type": "link_list",
      "id": "related_menu",
      "label": "Related menu fallback"
    },
    {
      "type": "range",
      "id": "related_limit",
      "label": "Related pages limit",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Detail page"
    }
  ]
}
{% endschema %}
