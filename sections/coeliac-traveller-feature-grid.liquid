{% comment %}
  Coeliac Traveller
{% endcomment %}
{{ 'coeliac-traveller.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="coeliac-traveller coeliac-traveller__section section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="coeliac-traveller__panel coeliac-traveller__feature-grid-panel">
      <div class="coeliac-traveller__section-header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="coeliac-traveller__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="coeliac-traveller__heading coeliac-traveller__heading--medium">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.body != blank -%}
          <div class="coeliac-traveller__body rte">{{ section.settings.body }}</div>
        {%- endif -%}
      </div>

      <div class="coeliac-traveller__feature-grid">
        {%- for block in section.blocks -%}
          <article class="coeliac-traveller__feature-card" {{ block.shopify_attributes }}>
            {%- if block.settings.kicker != blank -%}
              <span class="coeliac-traveller__feature-kicker">{{ block.settings.kicker }}</span>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="coeliac-traveller__feature-title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="coeliac-traveller__caption rte">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if block.settings.link_label != blank and block.settings.link != blank -%}
              <a class="coeliac-traveller__feature-link" href="{{ block.settings.link }}">
                {{ block.settings.link_label }}
              </a>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CT feature grid",
  "tag": "section",
  "class": "section section-coeliac-traveller-feature-grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Explore next"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Build out the content pillars"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>These cards are intended as the first reusable navigation layer for destination guides, blog content, product edits, and affiliate-style content.</p>"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature card",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "kicker",
          "label": "Kicker",
          "default": "Guides"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Gluten Free Guides"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Add a clear summary of the content area or destination collection you want people to explore.</p>"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Learn more"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Coeliac Traveller feature grid",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "kicker": "Guides",
            "title": "Gluten Free Guides",
            "text": "<p>Create destination roundups, airport tips, and practical food planning guides for coeliac travellers.</p>",
            "link_label": "View guides"
          }
        },
        {
          "type": "feature",
          "settings": {
            "kicker": "Advice",
            "title": "Travel Tips",
            "text": "<p>Share packing ideas, how to research safe dining, and what to prepare before takeoff.</p>",
            "link_label": "Read tips"
          }
        },
        {
          "type": "feature",
          "settings": {
            "kicker": "Shop",
            "title": "Products We Love",
            "text": "<p>Feature trusted items, gluten free staples, or travel products that fit the Coeliac Traveller brand.</p>",
            "link_label": "See products"
          }
        },
        {
          "type": "feature",
          "settings": {
            "kicker": "Journal",
            "title": "Latest Posts",
            "text": "<p>Use this space for creator-style content, itineraries, recommendations, and recent updates.</p>",
            "link_label": "Browse posts"
          }
        }
      ]
    }
  ]
}
{% endschema %}
