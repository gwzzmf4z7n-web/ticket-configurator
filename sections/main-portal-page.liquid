{{ 'section-portal.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign current_handle = page.handle | default: ''
  assign page_key = section.settings.portal_key | default: 'hub'
  assign return_to = page.url | default: request.path | default: routes.root_url
  assign heading_text = section.settings.heading | default: page.title
  assign intro_text = section.settings.intro
  assign trip_record = blank
  assign trip_title = blank
  assign trip_start_date = blank
  assign trip_end_date = blank
  assign trip_overview = blank
  assign booking_status = blank
  assign upcoming_plans = blank
  assign advisor_name = blank
  assign support_email = blank
  assign salesforce_placeholder = blank

  assign secret_shop_collection = section.settings.secret_shop_collection
  assign secret_shop_products_limit = section.settings.secret_shop_products_limit
  assign secret_shop_has_products = false
  assign credit_balance = 0
  assign credit_balance_cents = 0
  assign discount_percent = blank

  assign dashboard_card_count = 0
  assign next_step_count = 0
  assign past_trip_count = 0
  assign info_panel_count = 0

  if customer and customer.metafields.portal.credit_balance != blank and customer.metafields.portal.credit_balance.value != blank
    assign credit_balance = customer.metafields.portal.credit_balance.value | plus: 0
    assign credit_balance_cents = credit_balance | times: 10
  endif

  if customer and customer.metafields.portal.discount_percent != blank and customer.metafields.portal.discount_percent.value != blank
    assign discount_percent = customer.metafields.portal.discount_percent.value
  endif

  if customer and customer.metafields.portal.trip_record != blank and customer.metafields.portal.trip_record.value != blank
    assign trip_record = customer.metafields.portal.trip_record.value
    assign trip_title = trip_record.title.value
    assign trip_start_date = trip_record.trip_start_date.value
    assign trip_end_date = trip_record.trip_end_date.value
    assign trip_overview = trip_record.trip_overview.value
    assign booking_status = trip_record.booking_status.value
    assign upcoming_plans = trip_record.upcoming_plans.value
    assign advisor_name = trip_record.advisor_name.value
    assign support_email = trip_record.support_email.value
    assign salesforce_placeholder = trip_record.salesforce_placeholder.value
  endif

  for block in section.blocks
    case block.type
      when 'dashboard_card', 'portal_card'
        assign dashboard_card_count = dashboard_card_count | plus: 1
      when 'next_step'
        assign next_step_count = next_step_count | plus: 1
      when 'past_trip'
        assign past_trip_count = past_trip_count | plus: 1
      when 'info_panel'
        assign info_panel_count = info_panel_count | plus: 1
    endcase
  endfor

  assign has_live_trip = false
  if trip_record != blank or section.settings.show_demo_trip
    assign has_live_trip = true
  endif

  if page_key == 'hub'
    if customer and customer.first_name != blank
      assign heading_text = 'Welcome back, ' | append: customer.first_name
    elsif customer
      assign heading_text = 'Welcome back'
    endif
  endif

  capture protected_content
    echo '<div class="portal-shell">'
    render 'portal-nav', current_handle: current_handle

    echo '<header class="portal-hero">'
    if section.settings.eyebrow != blank
      echo '<p class="portal-hero__eyebrow">'
      echo section.settings.eyebrow
      echo '</p>'
    endif
    echo '<h1 class="portal-hero__heading h0">'
    echo heading_text | escape
    echo '</h1>'
    if intro_text != blank
      echo '<div class="portal-hero__intro rte">'
      echo intro_text
      echo '</div>'
    endif
    echo '</header>'

    comment
      Hub view: placeholder-driven dashboard for phase 1.
      Real trip data can later replace these settings via metafields or metaobjects.
    endcomment
    if page_key == 'hub'
      echo '<div class="portal-dashboard">'

      echo '<section class="portal-section portal-section--feature">'
      echo '<div class="portal-section__header">'
      echo '<div>'
      echo '<p class="portal-section__eyebrow">Portal overview</p>'
      echo '<h2 class="portal-section__title h2">Your client hub</h2>'
      echo '</div>'
      echo '<p class="portal-section__copy">This first phase is theme-powered only. The layout is ready for future metafields, metaobjects, and API integrations without changing the customer access flow.</p>'
      echo '</div>'

      if has_live_trip
        assign overview_kicker = section.settings.demo_trip_kicker
        assign overview_title = section.settings.demo_trip_title
        assign overview_dates = section.settings.demo_trip_dates
        assign overview_status = section.settings.demo_trip_status
        assign overview_summary = section.settings.demo_trip_summary
        assign overview_button_label = section.settings.demo_trip_button_label
        assign overview_button_link = section.settings.demo_trip_button_link

        if trip_record != blank
          assign overview_kicker = 'Upcoming trip'
          assign overview_title = trip_title | default: section.settings.demo_trip_title
          assign overview_status = booking_status | default: section.settings.demo_trip_status
          assign overview_summary = trip_overview | default: section.settings.demo_trip_summary
          assign overview_button_label = 'Open trip details'
          assign overview_button_link = pages['your-trip'].url | default: '/pages/your-trip'
          capture overview_dates
            if trip_start_date != blank
              echo trip_start_date | date: '%B %-d, %Y'
              if trip_end_date != blank
                echo ' to '
                echo trip_end_date | date: '%B %-d, %Y'
              endif
            endif
          endcapture
        endif

        echo '<article class="portal-feature-card">'
        echo '<div class="portal-feature-card__media">'
        echo '<div class="portal-feature-card__orbit"></div>'
        echo '<p class="portal-feature-card__eyebrow">'
        echo overview_kicker | escape
        echo '</p>'
        echo '<h3 class="portal-feature-card__title h2">'
        echo overview_title | escape
        echo '</h3>'
        if overview_summary != blank
          echo '<div class="portal-feature-card__copy rte">'
          echo overview_summary
          echo '</div>'
        endif
        echo '</div>'
        echo '<div class="portal-feature-card__details">'
        echo '<div class="portal-pill-group">'
        if overview_dates != blank
          echo '<span class="portal-pill">'
          echo overview_dates
          echo '</span>'
        endif
        if overview_status != blank
          echo '<span class="portal-pill portal-pill--accent">'
          echo overview_status | escape
          echo '</span>'
        endif
        if advisor_name != blank
          echo '<span class="portal-pill">Advisor: '
          echo advisor_name | escape
          echo '</span>'
        endif
        echo '</div>'
        echo '<div class="portal-feature-card__list">'
        echo '<p>Trip details, tickets, forms, and payment checkpoints can all slot into this dashboard structure later.</p>'
        if support_email != blank
          echo '<p>Support contact: <a href="mailto:'
          echo support_email | escape
          echo '">'
          echo support_email | escape
          echo '</a></p>'
        else
          echo '<p>Use the cards below as phase-1 placeholders until live data is connected.</p>'
        endif
        echo '</div>'
        if overview_button_link != blank and overview_button_label != blank
          echo '<div class="portal-feature-card__actions"><a class="button" href="'
          echo overview_button_link
          echo '">'
          echo overview_button_label | escape
          echo '</a></div>'
        endif
        echo '</div>'
        echo '</article>'
      else
        echo '<article class="portal-empty-state" role="status">'
        echo '<div class="portal-empty-state__content">'
        echo '<p class="portal-empty-state__eyebrow">No active trip yet</p>'
        echo '<h3 class="portal-empty-state__title h2">'
        echo section.settings.empty_state_heading | escape
        echo '</h3>'
        echo '<div class="portal-empty-state__copy rte">'
        echo section.settings.empty_state_body
        echo '</div>'
        echo '</div>'
        echo '<div class="portal-empty-state__actions">'
        if section.settings.empty_primary_label != blank and section.settings.empty_primary_link != blank
          echo '<a class="button" href="'
          echo section.settings.empty_primary_link
          echo '">'
          echo section.settings.empty_primary_label | escape
          echo '</a>'
        endif
        if section.settings.empty_secondary_label != blank and section.settings.empty_secondary_link != blank
          echo '<a class="button button--secondary" href="'
          echo section.settings.empty_secondary_link
          echo '">'
          echo section.settings.empty_secondary_label | escape
          echo '</a>'
        endif
        if section.settings.empty_tertiary_label != blank and section.settings.empty_tertiary_link != blank
          echo '<a class="portal-text-link" href="'
          echo section.settings.empty_tertiary_link
          echo '">'
          echo section.settings.empty_tertiary_label | escape
          echo '</a>'
        endif
        echo '</div>'
        echo '</article>'
      endif
      echo '</section>'

      if dashboard_card_count > 0
        echo '<section class="portal-section">'
        echo '<div class="portal-section__header">'
        echo '<div>'
        echo '<p class="portal-section__eyebrow">Quick access</p>'
        echo '<h2 class="portal-section__title h2">'
        echo section.settings.dashboard_heading
        echo '</h2>'
        echo '</div>'
        echo '<p class="portal-section__copy">Keep the first release simple: card-based navigation now, real customer-specific content later.</p>'
        echo '</div>'
        echo '<div class="portal-dashboard-grid">'
        for block in section.blocks
          unless block.type == 'dashboard_card' or block.type == 'portal_card'
            continue
          endunless

          assign card_eyebrow = block.settings.eyebrow | default: 'Portal area'
          assign card_title = block.settings.title
          assign card_description = block.settings.description
          assign card_status = block.settings.status
          assign card_link = block.settings.link
          assign card_link_label = block.settings.link_label | default: 'Open'

          echo '<article class="portal-dashboard-card" '
          echo block.shopify_attributes
          echo '>'
          echo '<div class="portal-dashboard-card__top">'
          echo '<p class="portal-dashboard-card__eyebrow">'
          echo card_eyebrow | escape
          echo '</p>'
          if card_status != blank
            echo '<span class="portal-dashboard-card__status">'
            echo card_status | escape
            echo '</span>'
          endif
          echo '</div>'
          echo '<h3 class="portal-dashboard-card__title h4">'
          echo card_title | escape
          echo '</h3>'
          if card_description != blank
            echo '<div class="portal-dashboard-card__copy rte">'
            echo card_description
            echo '</div>'
          endif
          if card_link != blank
            echo '<div class="portal-dashboard-card__actions"><a class="button button--secondary" href="'
            echo card_link
            echo '">'
            echo card_link_label | escape
            echo '</a></div>'
          endif
          echo '</article>'
        endfor
        echo '</div>'
        echo '</section>'
      endif

      if next_step_count > 0
        echo '<section class="portal-section">'
        echo '<div class="portal-section__header">'
        echo '<div>'
        echo '<p class="portal-section__eyebrow">Action list</p>'
        echo '<h2 class="portal-section__title h2">'
        echo section.settings.next_steps_heading
        echo '</h2>'
        echo '</div>'
        if section.settings.next_steps_intro != blank
          echo '<div class="portal-section__copy rte">'
          echo section.settings.next_steps_intro
          echo '</div>'
        endif
        echo '</div>'
        echo '<div class="portal-step-list">'
        assign next_step_index = 0
        for block in section.blocks
          unless block.type == 'next_step'
            continue
          endunless

          assign next_step_index = next_step_index | plus: 1

          echo '<article class="portal-step" '
          echo block.shopify_attributes
          echo '>'
          echo '<div class="portal-step__number">'
          if next_step_index < 10
            echo '0'
          endif
          echo next_step_index
          echo '</div>'
          echo '<div class="portal-step__content">'
          echo '<h3 class="portal-step__title h4">'
          echo block.settings.title | escape
          echo '</h3>'
          if block.settings.description != blank
            echo '<div class="portal-step__copy rte">'
            echo block.settings.description
            echo '</div>'
          endif
          echo '</div>'
          if block.settings.link != blank
            echo '<div class="portal-step__actions"><a class="portal-text-link" href="'
            echo block.settings.link
            echo '">'
            echo block.settings.link_label | default: 'Open' | escape
            echo '</a></div>'
          endif
          echo '</article>'
        endfor
        echo '</div>'
        echo '</section>'
      endif

      echo '<section class="portal-section">'
      echo '<div class="portal-section__header">'
      echo '<div>'
      echo '<p class="portal-section__eyebrow">Archive</p>'
      echo '<h2 class="portal-section__title h2">'
      echo section.settings.past_trips_heading
      echo '</h2>'
      echo '</div>'
      if section.settings.past_trips_intro != blank
        echo '<div class="portal-section__copy rte">'
        echo section.settings.past_trips_intro
        echo '</div>'
      endif
      echo '</div>'

      if past_trip_count > 0
        echo '<div class="portal-past-trips">'
        for block in section.blocks
          unless block.type == 'past_trip'
            continue
          endunless

          echo '<article class="portal-past-trip" '
          echo block.shopify_attributes
          echo '>'
          echo '<p class="portal-past-trip__dates">'
          echo block.settings.dates | escape
          echo '</p>'
          echo '<h3 class="portal-past-trip__title h4">'
          echo block.settings.title | escape
          echo '</h3>'
          if block.settings.description != blank
            echo '<div class="portal-past-trip__copy rte">'
            echo block.settings.description
            echo '</div>'
          endif
          if block.settings.link != blank
            echo '<a class="portal-text-link" href="'
            echo block.settings.link
            echo '">'
            echo block.settings.link_label | default: 'View details' | escape
            echo '</a>'
          endif
          echo '</article>'
        endfor
        echo '</div>'
      else
        echo '<div class="portal-note rte"><p>Past trips will appear here once you add them as section blocks or connect customer trip data later.</p></div>'
      endif
      echo '</section>'

      if section.settings.cta_heading != blank or section.settings.cta_button_label != blank
        echo '<section class="portal-cta">'
        echo '<div>'
        if section.settings.cta_heading != blank
          echo '<p class="portal-cta__eyebrow">Next adventure</p>'
          echo '<h2 class="portal-cta__title h2">'
          echo section.settings.cta_heading | escape
          echo '</h2>'
        endif
        if section.settings.cta_body != blank
          echo '<div class="portal-cta__copy rte">'
          echo section.settings.cta_body
          echo '</div>'
        endif
        echo '</div>'
        if section.settings.cta_button_label != blank and section.settings.cta_button_link != blank
          echo '<div class="portal-cta__actions"><a class="button" href="'
          echo section.settings.cta_button_link
          echo '">'
          echo section.settings.cta_button_label | escape
          echo '</a></div>'
        endif
        echo '</section>'
      endif

      echo '</div>'
    endif

    if page_key == 'trip'
      if trip_record != blank
        echo '<div class="portal-grid portal-grid--stats">'

        echo '<article class="portal-stat">'
        echo '<p class="portal-stat__label">Trip title</p>'
        echo '<p class="portal-stat__value h2">'
        echo trip_title | default: 'Your trip' | escape
        echo '</p>'
        echo '<p class="portal-stat__meta">'
        if trip_start_date != blank
          echo trip_start_date | date: '%B %-d, %Y'
        else
          echo 'Add trip dates when ready.'
        endif
        echo '</p>'
        echo '</article>'

        echo '<article class="portal-stat">'
        echo '<p class="portal-stat__label">Booking status</p>'
        echo '<p class="portal-stat__value h2">'
        echo booking_status | default: 'Pending' | escape
        echo '</p>'
        echo '<p class="portal-stat__meta">'
        if advisor_name != blank
          echo 'Managed by '
          echo advisor_name | escape
        else
          echo 'Assign an advisor later.'
        endif
        echo '</p>'
        echo '</article>'

        echo '<article class="portal-stat">'
        echo '<p class="portal-stat__label">Support</p>'
        echo '<p class="portal-stat__value h5">'
        if support_email != blank
          echo '<a href="mailto:'
          echo support_email | escape
          echo '">'
          echo support_email | escape
          echo '</a>'
        else
          echo 'Contact to be added'
        endif
        echo '</p>'
        echo '<p class="portal-stat__meta">Reserved for future synced trip data.</p>'
        echo '</article>'

        echo '</div>'
      endif

      if info_panel_count > 0
        echo '<div class="portal-grid portal-grid--panels">'
        for block in section.blocks
          unless block.type == 'info_panel'
            continue
          endunless

          assign panel_classes = 'portal-panel'
          if block.settings.width == 'full'
            assign panel_classes = panel_classes | append: ' portal-panel--full'
          endif

          assign panel_body = block.settings.body

          if trip_record != blank
            case block.settings.title
              when 'Trip Overview'
                assign panel_body = trip_overview | default: block.settings.body
              when 'Booking Status'
                capture panel_body
                  echo '<p>'
                  echo booking_status | default: 'No booking status has been added yet.' | escape
                  echo '</p>'
                  if trip_start_date != blank
                    echo '<p>Departure: '
                    echo trip_start_date | date: '%B %-d, %Y'
                    echo '</p>'
                  endif
                  if trip_end_date != blank
                    echo '<p>Return: '
                    echo trip_end_date | date: '%B %-d, %Y'
                    echo '</p>'
                  endif
                endcapture
              when 'Upcoming Plans'
                assign panel_body = upcoming_plans | default: block.settings.body
              when 'Future Salesforce / Itinerary Integration'
                assign panel_body = salesforce_placeholder | default: block.settings.body
            endcase
          endif

          echo '<article class="'
          echo panel_classes
          echo '" '
          echo block.shopify_attributes
          echo '>'
          echo '<h2 class="portal-panel__title h3">'
          echo block.settings.title | escape
          echo '</h2>'
          if panel_body != blank
            echo '<div class="portal-panel__body rte">'
            echo panel_body
            echo '</div>'
          endif
          echo '</article>'
        endfor
        echo '</div>'
      endif

      if trip_record == blank
        echo '<div class="portal-note rte"><p>No trip record is assigned to this customer yet.</p><p>Add a future metafield or metaobject later and this page can populate without changing the template.</p></div>'
      endif
    endif

    if page_key == 'shop'
      echo '<div class="portal-grid portal-grid--stats">'

      echo '<article class="portal-stat">'
      echo '<p class="portal-stat__label">Available credits</p>'
      echo '<p class="portal-stat__value">'
      echo credit_balance
      echo '</p>'
      echo '<p class="portal-stat__meta">'
      echo credit_balance_cents | money_without_trailing_zeros
      echo ' equivalent</p>'
      echo '</article>'

      echo '<article class="portal-stat">'
      echo '<p class="portal-stat__label">Member discount</p>'
      echo '<p class="portal-stat__value">'
      if discount_percent != blank
        echo discount_percent
        echo '%'
      else
        echo 'TBC'
      endif
      echo '</p>'
      echo '<p class="portal-stat__meta">Reserved for future synced discount logic.</p>'
      echo '</article>'

      echo '<article class="portal-stat">'
      echo '<p class="portal-stat__label">Credit conversion</p>'
      echo '<p class="portal-stat__value">10</p>'
      echo '<p class="portal-stat__meta">1 credit = '
      echo 10 | money_without_trailing_zeros
      echo ' in reward value.</p>'
      echo '</article>'

      echo '</div>'

      if secret_shop_collection != blank and secret_shop_collection.products_count > 0
        assign secret_shop_has_products = true
        echo '<div class="portal-shop">'
        echo '<div class="portal-shop__header">'
        echo '<div><p class="portal-section__eyebrow">'
        echo section.settings.secret_shop_collection_label
        echo '</p>'
        echo '<h2 class="h2">'
        echo secret_shop_collection.title | escape
        echo '</h2></div>'
        echo '<div class="portal-shop__meta rte">'
        echo section.settings.secret_shop_helper_text
        echo '</div>'
        echo '</div>'

        echo '<div class="portal-shop__grid">'
        for product in secret_shop_collection.products limit: secret_shop_products_limit
          assign credit_cost = 0
          assign credit_cost_cents = 0
          if product.metafields.portal.credit_cost != blank and product.metafields.portal.credit_cost.value != blank
            assign credit_cost = product.metafields.portal.credit_cost.value | plus: 0
            assign credit_cost_cents = credit_cost | times: 10
          else
            assign credit_cost_cents = product.price
            assign credit_cost = product.price | divided_by: 10
          endif

          echo '<article class="portal-shop-card">'
          echo '<a class="portal-shop-card__media" href="'
          echo product.url
          echo '">'
          if product.featured_image != blank
            echo '<img src="'
            echo product.featured_image | image_url: width: 720
            echo '" alt="'
            echo product.featured_image.alt | escape
            echo '" loading="lazy" width="720">'
          else
            echo '<div class="portal-shop-card__placeholder">No image</div>'
          endif
          echo '</a>'
          echo '<div class="portal-shop-card__content">'
          echo '<p class="portal-shop-card__eyebrow">'
          if product.available
            echo 'Member reward'
          else
            echo 'Currently unavailable'
          endif
          echo '</p>'
          echo '<h3 class="portal-shop-card__title h4"><a href="'
          echo product.url
          echo '">'
          echo product.title | escape
          echo '</a></h3>'
          if product.description != blank
            echo '<div class="portal-shop-card__description rte">'
            echo product.description | strip_html | truncatewords: 22
            echo '</div>'
          endif
          echo '<div class="portal-shop-card__pricing">'
          echo '<p class="portal-shop-card__credits">'
          if credit_cost > 0
            echo credit_cost
            echo ' credits'
          else
            echo 'Credit cost unavailable'
          endif
          echo '</p>'
          echo '<p class="portal-shop-card__money">'
          if credit_cost_cents > 0
            echo credit_cost_cents | money_without_trailing_zeros
          else
            echo product.price | money_without_trailing_zeros
          endif
          echo '</p>'
          echo '</div>'
          echo '<div class="portal-shop-card__footer">'
          if credit_cost > 0 and credit_balance >= credit_cost
            echo '<span class="portal-shop-card__status portal-shop-card__status--available">Enough credits available</span>'
          elsif credit_cost > 0
            echo '<span class="portal-shop-card__status">Additional credits required</span>'
          else
            echo '<span class="portal-shop-card__status">Check product price</span>'
          endif
          echo '<a class="button button--secondary" href="'
          echo product.url
          echo '">View reward</a>'
          echo '</div>'
          echo '</div>'
          echo '</article>'
        endfor
        echo '</div>'
        echo '</div>'
      endif

      if secret_shop_has_products == false
        echo '<div class="portal-note rte"><p>No Secret Shop collection is selected yet.</p><p>Choose a collection in the theme editor when you are ready to populate this member area.</p></div>'
      endif
    endif

    if section.settings.show_page_content and page.content != blank
      echo '<div class="portal-page-content"><div class="rte">'
      echo page.content
      echo '</div></div>'
    endif

    if section.settings.member_note != blank
      echo '<div class="portal-note rte">'
      echo section.settings.member_note
      echo '</div>'
    endif

    echo '</div>'
  endcapture
-%}

<section class="portal-area section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {% render 'portal-login-gate',
      title: section.settings.logged_out_title,
      message: section.settings.logged_out_message,
      button_label: section.settings.login_button_label,
      return_to: return_to,
      gated_content: protected_content
    %}
  </div>
</section>

{% schema %}
{
  "name": "Portal page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "portal_key",
      "label": "Portal page type",
      "default": "hub",
      "options": [
        {
          "value": "hub",
          "label": "Client Hub"
        },
        {
          "value": "trip",
