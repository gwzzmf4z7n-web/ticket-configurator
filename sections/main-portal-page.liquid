    },
    {
      "type": "text",
      "id": "empty_tertiary_label",
      "label": "Empty state text link label",
      "default": "View planning guides"
    },
    {
      "type": "url",
      "id": "empty_tertiary_link",
      "label": "Empty state text link"
    },
    {
      "type": "header",
      "content": "Bottom CTA"
    },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "CTA heading",
      "default": "Plan Your Next Adventure"
    },
    {
      "type": "richtext",
      "id": "cta_body",
      "label": "CTA body",
      "default": "<p>Keep one strong call to action at the bottom of the hub so clients always know the next planning path.</p>"
    },
    {
      "type": "text",
      "id": "cta_button_label",
      "label": "CTA button label",
      "default": "Plan Your Next Adventure"
    },
    {
      "type": "url",
      "id": "cta_button_link",
      "label": "CTA button link"
    },
    {
      "type": "header",
      "content": "Logged out state"
    },
    {
      "type": "inline_richtext",
      "id": "guest_eyebrow",
      "label": "Guest eyebrow",
      "default": "MrChocolate client hub"
    },
    {
      "type": "text",
      "id": "guest_heading",
      "label": "Guest heading",
      "default": "Choose the planning support that fits your trip"
    },
    {
      "type": "richtext",
