      "id": "cta_button_label",
      "label": "CTA button label",
      "default": "Plan Your Next Adventure"
    },
    {
      "type": "url",
      "id": "cta_button_link",
      "label": "CTA button link"
    },
    {
      "type": "header",
      "content": "Logged out state"
    },
    {
      "type": "inline_richtext",
      "id": "logged_out_title",
      "label": "Logged out heading",
      "default": "Please log in to access your portal"
    },
    {
      "type": "richtext",
      "id": "logged_out_message",
      "label": "Logged out message",
      "default": "<p>You need to be logged in with your Shopify customer account to view this private area.</p>"
    },
    {
      "type": "text",
      "id": "login_button_label",
      "label": "Login button label",
      "default": "Log in"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Secret Shop"
    },
    {
      "type": "collection",
      "id": "secret_shop_collection",
      "label": "Secret Shop collection"
    },
    {
      "type": "inline_richtext",
      "id": "secret_shop_collection_label",
      "label": "Secret Shop collection label",
      "default": "Member collection"
    },
    {
      "type": "richtext",
      "id": "secret_shop_helper_text",
      "label": "Secret Shop helper text",
      "default": "<p>This page displays products from one curated collection. Product credit pricing can later come from metafields or synced external data.</p>"
    },
    {
      "type": "range",
      "id": "secret_shop_products_limit",
      "min": 2,
      "max": 24,
      "step": 1,
      "label": "Products to show",
      "default": 8
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "quick_action",
      "name": "Quick action",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Quick action" },
        { "type": "text", "id": "title", "label": "Title", "default": "Review itinerary" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "compass",
          "options": [
            { "value": "compass", "label": "Compass" },
            { "value": "ticket", "label": "Ticket" },
            { "value": "clipboard", "label": "Clipboard" },
            { "value": "card", "label": "Card" },
            { "value": "plane", "label": "Plane" },
            { "value": "sparkle", "label": "Sparkle" }
          ]
        },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Open" }
      ]
    },
    {
      "type": "quick_link",
      "name": "Quick link",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Itinerary" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "map",
          "options": [
            { "value": "map", "label": "Map" },
            { "value": "ticket", "label": "Ticket" },
            { "value": "clipboard", "label": "Clipboard" },
            { "value": "card", "label": "Card" },
            { "value": "bag", "label": "Bag" }
          ]
        },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "dashboard_card",
