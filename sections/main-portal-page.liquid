    },
    {
      "type": "richtext",
      "id": "travefy_empty_message",
      "label": "Missing itinerary message",
      "default": "<p>No Travefy itinerary has been linked to this customer yet.</p>"
    },
    {
      "type": "text",
      "id": "travefy_script_src",
      "label": "Travefy embed script URL",
      "default": "//d1h0qti89a78h.cloudfront.net/embed/itinerary.1.0.js"
    },
    {
      "type": "inline_richtext",
      "id": "next_steps_heading",
      "label": "Next steps heading",
      "default": "Next steps"
    },
    {
      "type": "richtext",
      "id": "next_steps_intro",
      "label": "Next steps intro",
