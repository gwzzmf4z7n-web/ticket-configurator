{{ 'section-portal.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign current_handle = page.handle | default: ''
  assign return_to = page.url | default: request.path | default: routes.root_url
  assign heading_text = section.settings.heading | default: page.title
  assign intro_text = section.settings.intro
  assign page_key = section.settings.portal_key
  assign trip_record = blank
  assign trip_title = blank
  assign trip_start_date = blank
  assign trip_end_date = blank
  assign trip_overview = blank
  assign booking_status = blank
  assign upcoming_plans = blank
  assign salesforce_placeholder = blank
  assign advisor_name = blank
  assign support_email = blank
  assign days_until_trip = blank
  assign trip_countdown_label = blank
  assign now_timestamp = 'now' | date: '%s' | plus: 0
  assign trip_is_live = false
  assign credit_balance = 0
  assign credit_balance_cents = 0
  assign discount_percent = blank
  assign secret_shop_collection = section.settings.secret_shop_collection
  assign secret_shop_products_limit = section.settings.secret_shop_products_limit
  assign secret_shop_has_products = false

  if customer and customer.metafields.portal.credit_balance != blank and customer.metafields.portal.credit_balance.value != blank
    assign credit_balance = customer.metafields.portal.credit_balance.value | plus: 0
    assign credit_balance_cents = credit_balance | times: 10
  endif

  if customer and customer.metafields.portal.discount_percent != blank and customer.metafields.portal.discount_percent.value != blank
    assign discount_percent = customer.metafields.portal.discount_percent.value
  endif

  if customer and customer.metafields.portal.trip_record != blank and customer.metafields.portal.trip_record.value != blank
    assign trip_record = customer.metafields.portal.trip_record.value
    assign trip_title = trip_record.title.value
    assign trip_start_date = trip_record.trip_start_date.value
    assign trip_end_date = trip_record.trip_end_date.value
    assign trip_overview = trip_record.trip_overview.value
    assign booking_status = trip_record.booking_status.value
    assign upcoming_plans = trip_record.upcoming_plans.value
    assign salesforce_placeholder = trip_record.salesforce_placeholder.value
    assign advisor_name = trip_record.advisor_name.value
    assign support_email = trip_record.support_email.value

    if trip_start_date != blank
      assign trip_start_timestamp = trip_start_date | date: '%s' | plus: 0
      assign trip_end_timestamp = blank

      if trip_end_date != blank
        assign trip_end_timestamp = trip_end_date | date: '%s' | plus: 0
        if trip_end_timestamp >= now_timestamp and trip_start_timestamp <= now_timestamp
          assign trip_is_live = true
        endif
      endif

      assign days_until_trip = trip_start_timestamp | minus: now_timestamp | divided_by: 86400

      if days_until_trip > 0
        assign trip_countdown_label = 'Days until departure'
      elsif days_until_trip == 0
        assign trip_countdown_label = 'Trip starts today'
      elsif trip_end_timestamp != blank and trip_end_timestamp >= now_timestamp
        assign trip_countdown_label = 'Trip in progress'
      else
        assign trip_countdown_label = 'Trip start date'
      endif
    endif
  endif

  if page_key == 'hub'
    if customer and customer.first_name != blank
      assign heading_text = 'Welcome back, ' | append: customer.first_name
    elsif customer
      assign heading_text = 'Welcome back'
    endif
  endif

  capture protected_content
    echo '<div class="portal-shell">'
    render 'portal-nav', current_handle: current_handle

    echo '<header class="portal-hero">'
    if section.settings.eyebrow != blank
      echo '<p class="portal-hero__eyebrow">'
      echo section.settings.eyebrow
      echo '</p>'
    endif
    echo '<h1 class="portal-hero__heading h0">'
    echo heading_text | escape
    echo '</h1>'
    if intro_text != blank
      echo '<div class="portal-hero__intro rte">'
      echo intro_text
      echo '</div>'
    endif
    echo '</header>'

    if page_key == 'trip'
      if trip_record != blank
        echo '<div class="portal-grid portal-grid--stats">'

        echo '<article class="portal-stat">'
        echo '<p class="portal-stat__label">'
        if trip_countdown_label != blank
          echo trip_countdown_label
        else
          echo 'Trip countdown'
        endif
        echo '</p>'
        echo '<p class="portal-stat__value">'
        if trip_start_date == blank
          echo 'TBC'
        elsif days_until_trip > 0
          echo days_until_trip
        elsif days_until_trip == 0
          echo 'Today'
        elsif trip_is_live
          echo 'Live'
        else
          echo trip_start_date | date: '%b %-d'
        endif
        echo '</p>'
        echo '<p class="portal-stat__meta">'
        if trip_start_date != blank
          echo trip_start_date | date: '%B %-d, %Y'
        else
          echo 'Add a trip start date to show the countdown.'
        endif
        echo '</p>'
        echo '</article>'

        echo '<article class="portal-stat">'
        echo '<p class="portal-stat__label">Trip title</p>'
        echo '<p class="portal-stat__value h2">'
        if trip_title != blank
          echo trip_title | escape
        else
          echo 'Your trip'
        endif
        echo '</p>'
        echo '<p class="portal-stat__meta">'
        if advisor_name != blank
          echo 'Managed by ' | append: advisor_name | escape
        else
          echo 'Assign an advisor name when ready.'
        endif
        echo '</p>'
        echo '</article>'

        echo '<article class="portal-stat">'
        echo '<p class="portal-stat__label">Booking status</p>'
        echo '<p class="portal-stat__value h2">'
        if booking_status != blank
          echo booking_status | escape
        else
          echo 'Pending'
        endif
        echo '</p>'
        echo '<p class="portal-stat__meta">'
        if trip_end_date != blank
          echo 'Returns '
          echo trip_end_date | date: '%B %-d, %Y'
        else
          echo 'Add an end date for a full trip window.'
        endif
        echo '</p>'
        echo '</article>'

        echo '</div>'
      endif
    endif

    if page_key == 'shop'
      echo '<div class="portal-grid portal-grid--stats">'

      echo '<article class="portal-stat">'
      echo '<p class="portal-stat__label">Available credits</p>'
      echo '<p class="portal-stat__value">'
      echo credit_balance
      echo '</p>'
      echo '<p class="portal-stat__meta">'
      echo credit_balance_cents | money_without_trailing_zeros
      echo ' equivalent'
      echo '</p>'
      echo '</article>'

      echo '<article class="portal-stat">'
      echo '<p class="portal-stat__label">Member discount</p>'
      echo '<p class="portal-stat__value">'
      if discount_percent != blank
        echo discount_percent
        echo '%'
      else
        echo 'TBC'
      endif
      echo '</p>'
      echo '<p class="portal-stat__meta">'
      if discount_percent != blank
        echo 'This is the current synced rate intended for future checkout discount logic.'
      else
        echo 'Add customer metafield portal.discount_percent when the Salesforce sync is ready.'
      endif
      echo '</p>'
      echo '</article>'

      echo '<article class="portal-stat">'
      echo '<p class="portal-stat__label">Credit conversion</p>'
      echo '<p class="portal-stat__value">'
      echo '10'
      echo '</p>'
      echo '<p class="portal-stat__meta">1 credit = '
      echo 10 | money_without_trailing_zeros
      echo ' in reward value.</p>'
      echo '</article>'

      echo '</div>'

      if secret_shop_collection != blank and secret_shop_collection.products_count > 0
        assign secret_shop_has_products = true
        echo '<div class="portal-shop">'
        echo '<div class="portal-shop__header">'
        echo '<div><p class="portal-hero__eyebrow">'
        echo section.settings.secret_shop_collection_label
        echo '</p>'
        echo '<h2 class="h2">'
        echo secret_shop_collection.title | escape
        echo '</h2></div>'
        echo '<div class="portal-shop__meta rte">'
        if section.settings.secret_shop_helper_text != blank
          echo section.settings.secret_shop_helper_text
        else
          echo '<p>Attach products to your chosen Secret Shop collection and set <code>product.metafields.portal.credit_cost</code> on each item.</p>'
        endif
        echo '</div>'
        echo '</div>'

        echo '<div class="portal-shop__grid">'
        for product in secret_shop_collection.products limit: secret_shop_products_limit
          assign credit_cost = 0
          assign credit_cost_cents = 0
          if product.metafields.portal.credit_cost != blank and product.metafields.portal.credit_cost.value != blank
            assign credit_cost = product.metafields.portal.credit_cost.value | plus: 0
            assign credit_cost_cents = credit_cost | times: 10
          endif

          echo '<article class="portal-shop-card">'
          echo '<a class="portal-shop-card__media" href="'
          echo product.url
          echo '">'
          if product.featured_image != blank
            echo '<img src="'
            echo product.featured_image | image_url: width: 720
            echo '" alt="'
            echo product.featured_image.alt | escape
            echo '" loading="lazy" width="720">'
          else
            echo '<div class="portal-shop-card__placeholder">No image</div>'
          endif
          echo '</a>'

          echo '<div class="portal-shop-card__content">'
          echo '<p class="portal-shop-card__eyebrow">'
          if product.available
            echo 'Member reward'
          else
            echo 'Currently unavailable'
          endif
          echo '</p>'
          echo '<h3 class="portal-shop-card__title h4"><a href="'
          echo product.url
          echo '">'
          echo product.title | escape
          echo '</a></h3>'

          if product.description != blank
            echo '<div class="portal-shop-card__description rte">'
            echo product.description | strip_html | truncatewords: 22
            echo '</div>'
          endif

          echo '<div class="portal-shop-card__pricing">'
          echo '<p class="portal-shop-card__credits">'
          if credit_cost > 0
            echo credit_cost
            echo ' credits'
          else
            echo 'Credit cost not set'
          endif
          echo '</p>'
          echo '<p class="portal-shop-card__money">'
          if credit_cost_cents > 0
            echo credit_cost_cents | money_without_trailing_zeros
          else
            echo product.price | money_without_trailing_zeros
          endif
          echo '</p>'
          echo '</div>'

          echo '<div class="portal-shop-card__footer">'
          if credit_cost > 0 and credit_balance >= credit_cost
            echo '<span class="portal-shop-card__status portal-shop-card__status--available">Enough credits available</span>'
          elsif credit_cost > 0
            echo '<span class="portal-shop-card__status">Additional credits required</span>'
          else
            echo '<span class="portal-shop-card__status">Set portal.credit_cost on this product</span>'
          endif
          echo '<a class="button button--secondary" href="'
          echo product.url
          echo '">View reward</a>'
          echo '</div>'
          echo '</div>'
          echo '</article>'
        endfor
        echo '</div>'
        echo '</div>'
      endif
    endif

    if page_key == 'hub'
      assign has_cards = false
      for block in section.blocks
        if block.type == 'portal_card'
          assign has_cards = true
          break
        endif
      endfor

      if has_cards
        echo '<div class="portal-grid portal-grid--cards">'
        for block in section.blocks
          if block.type != 'portal_card'
            continue
          endif

          echo '<article class="portal-card" '
          echo block.shopify_attributes
          echo '>'
          echo '<h2 class="portal-card__title h3">'
          echo block.settings.title | escape
          echo '</h2>'
          if block.settings.description != blank
            echo '<div class="portal-card__description rte">'
            echo block.settings.description
            echo '</div>'
          endif
          if block.settings.link != blank
            echo '<div class="portal-card__actions"><a class="button" href="'
            echo block.settings.link
            echo '">'
            echo block.settings.link_label | escape
            echo '</a></div>'
          endif
          echo '</article>'
        endfor
        echo '</div>'
      endif
    endif

    assign has_panels = false
    for block in section.blocks
      if block.type == 'info_panel'
        assign has_panels = true
        break
      endif
    endfor

    if has_panels
      echo '<div class="portal-grid portal-grid--panels">'
      for block in section.blocks
        if block.type != 'info_panel'
          continue
        endif

        assign panel_classes = 'portal-panel'
        if block.settings.width == 'full'
          assign panel_classes = panel_classes | append: ' portal-panel--full'
        endif
        assign panel_title = block.settings.title
        assign panel_body = block.settings.body

        if page_key == 'trip' and trip_record != blank
          case block.settings.title
            when 'Trip Overview'
              if trip_overview != blank
                assign panel_body = trip_overview | newline_to_br
              endif
            when 'Booking Status'
              capture panel_body
                echo '<p>'
                if booking_status != blank
                  echo booking_status | escape
                else
                  echo 'No booking status has been added yet.'
                endif
                echo '</p>'
                if trip_start_date != blank
                  echo '<p>Departure: '
                  echo trip_start_date | date: '%B %-d, %Y'
                  echo '</p>'
                endif
                if trip_end_date != blank
                  echo '<p>Return: '
                  echo trip_end_date | date: '%B %-d, %Y'
                  echo '</p>'
                endif
              endcapture
            when 'Upcoming Plans'
              if upcoming_plans != blank
                assign panel_body = upcoming_plans | newline_to_br
              endif
            when 'Future Salesforce / Itinerary Integration'
              capture panel_body
                if salesforce_placeholder != blank
                  echo salesforce_placeholder | newline_to_br
                else
                  echo '<p>This reserved panel is ready for future Salesforce-connected trip data, itinerary feeds, documents, or support notes.</p>'
                endif
                if support_email != blank
                  echo '<p>Current support contact: <a href="mailto:'
                  echo support_email
                  echo '">'
                  echo support_email
                  echo '</a></p>'
                endif
              endcapture
          endcase
        endif

        echo '<article class="'
        echo panel_classes
        echo '" '
        echo block.shopify_attributes
        echo '>'
        echo '<h2 class="portal-panel__title h3">'
        echo panel_title | escape
        echo '</h2>'
        if panel_body != blank
          echo '<div class="portal-panel__body rte">'
          echo panel_body
          echo '</div>'
        endif
        echo '</article>'
      endfor
      echo '</div>'
    endif

    if page_key == 'trip' and trip_record == blank
      echo '<div class="portal-note rte"><p>No trip record is assigned to this customer yet.</p><p>Once you attach a <strong>Trip Record</strong> to <code>portal.trip_record</code>, this page will populate automatically.</p></div>'
    endif

    if page_key == 'shop' and secret_shop_has_products == false
      echo '<div class="portal-note rte"><p>No Secret Shop collection is selected yet.</p><p>Choose a collection in the page template settings, then add a <code>portal.credit_cost</code> product metafield to each reward item.</p></div>'
    endif

    if section.settings.show_page_content and page.content != blank
      echo '<div class="portal-page-content"><div class="rte">'
      echo page.content
      echo '</div></div>'
    endif

    if section.settings.member_note != blank
      echo '<div class="portal-note rte">'
      echo section.settings.member_note
      echo '</div>'
    endif

    echo '</div>'
  endcapture
-%}

<section class="portal-area section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {% render 'portal-login-gate',
      title: section.settings.logged_out_title,
      message: section.settings.logged_out_message,
      button_label: section.settings.login_button_label,
      return_to: return_to,
      gated_content: protected_content
    %}
  </div>
</section>

{% schema %}
{
  "name": "Portal page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "portal_key",
      "label": "Portal page type",
      "default": "hub",
      "options": [
        {
          "value": "hub",
          "label": "Client Hub"
        },
        {
          "value": "trip",
          "label": "Your Trip"
        },
        {
          "value": "shop",
          "label": "Secret Shop"
        }
      ]
    },
    {
      "type": "inline_richtext",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Private customer portal"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Client Hub"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text",
      "default": "<p>Use this private area to access your trip information and member-only experiences.</p>"
    },
    {
      "type": "richtext",
      "id": "member_note",
      "label": "Member note",
      "default": "<p>This section is theme-powered today and ready for future Shopify metafield, metaobject, or external integration work.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_page_content",
      "label": "Show page body content below portal modules",
      "default": false
    },
    {
      "type": "inline_richtext",
      "id": "logged_out_title",
      "label": "Logged out heading",
      "default": "Please log in to access your portal"
    },
    {
      "type": "richtext",
      "id": "logged_out_message",
      "label": "Logged out message",
      "default": "<p>You need to be logged in with your Shopify customer account to view this private area.</p>"
    },
    {
      "type": "text",
      "id": "login_button_label",
      "label": "Login button label",
      "default": "Log in"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Secret Shop"
    },
    {
      "type": "collection",
      "id": "secret_shop_collection",
      "label": "Secret Shop collection"
    },
    {
      "type": "inline_richtext",
      "id": "secret_shop_collection_label",
      "label": "Secret Shop collection label",
      "default": "Member collection"
    },
    {
      "type": "richtext",
      "id": "secret_shop_helper_text",
      "label": "Secret Shop helper text",
      "default": "<p>This page displays products from one curated collection. Product credit pricing is read from the portal credit cost product metafield.</p>"
    },
    {
      "type": "range",
      "id": "secret_shop_products_limit",
      "min": 2,
      "max": 24,
      "step": 1,
      "label": "Products to show",
      "default": 8
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "portal_card",
      "name": "Portal card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Your Trip"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Add a short description for this destination page.</p>"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Button label",
          "default": "Open"
        }
      ]
    },
    {
      "type": "info_panel",
      "name": "Info panel",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Panel heading"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body",
          "default": "<p>Add content for logged-in customers here.</p>"
        },
        {
          "type": "select",
          "id": "width",
          "label": "Width",
          "default": "half",
          "options": [
            {
              "value": "half",
              "label": "Half width"
            },
            {
              "value": "full",
              "label": "Full width"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Portal page"
    }
  ]
}
{% endschema %}
