{{ 'section-portal.css' | asset_url | stylesheet_tag }}
{{ 'portal-data.js' | asset_url | script_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign current_handle = page.handle | default: ''
  assign page_key = section.settings.portal_key | default: 'hub'
  assign return_to = page.url | default: request.path | default: routes.root_url
  assign heading_text = section.settings.heading | default: page.title
  assign intro_text = section.settings.intro

  assign trip_record = blank
  assign trip_title = blank
  assign trip_start_date = blank
  assign trip_end_date = blank
  assign trip_overview = blank
  assign booking_status = blank
  assign upcoming_plans = blank
  assign advisor_name = blank
  assign support_email = blank
  assign salesforce_placeholder = blank
  assign travefy_itinerary_id = blank
  assign show_travefy_embed = false

  assign secret_shop_collection = section.settings.secret_shop_collection
  assign secret_shop_products_limit = section.settings.secret_shop_products_limit
  assign secret_shop_has_products = false
  assign credit_balance = 0
  assign credit_balance_cents = 0
  assign discount_percent = blank

  assign quick_action_count = 0
  assign quick_link_count = 0
  assign dashboard_card_count = 0
  assign next_step_count = 0
  assign past_trip_count = 0
  assign info_panel_count = 0

  if customer and customer.metafields.portal.credit_balance != blank and customer.metafields.portal.credit_balance.value != blank
    assign credit_balance = customer.metafields.portal.credit_balance.value | plus: 0
    assign credit_balance_cents = credit_balance | times: 10
  endif

  if customer and customer.metafields.portal.discount_percent != blank and customer.metafields.portal.discount_percent.value != blank
    assign discount_percent = customer.metafields.portal.discount_percent.value
  endif

  if customer and customer.metafields.portal.trip_record != blank and customer.metafields.portal.trip_record.value != blank
    assign trip_record = customer.metafields.portal.trip_record.value
    assign trip_title = trip_record.title.value
    assign trip_start_date = trip_record.trip_start_date.value
    assign trip_end_date = trip_record.trip_end_date.value
    assign trip_overview = trip_record.trip_overview.value
    assign booking_status = trip_record.booking_status.value
    assign upcoming_plans = trip_record.upcoming_plans.value
    assign advisor_name = trip_record.advisor_name.value
    assign support_email = trip_record.support_email.value
    assign salesforce_placeholder = trip_record.salesforce_placeholder.value
  endif

  if customer and customer.metafields.portal.travefy_itinerary_id != blank and customer.metafields.portal.travefy_itinerary_id.value != blank
    assign travefy_itinerary_id = customer.metafields.portal.travefy_itinerary_id.value | strip
  endif

  for block in section.blocks
    case block.type
      when 'quick_action'
        assign quick_action_count = quick_action_count | plus: 1
      when 'quick_link'
        assign quick_link_count = quick_link_count | plus: 1
      when 'dashboard_card', 'portal_card'
        assign dashboard_card_count = dashboard_card_count | plus: 1
      when 'next_step'
        assign next_step_count = next_step_count | plus: 1
      when 'past_trip'
        assign past_trip_count = past_trip_count | plus: 1
      when 'info_panel'
        assign info_panel_count = info_panel_count | plus: 1
    endcase
  endfor

  assign has_live_trip = false
  if trip_record != blank or section.settings.show_demo_trip
    assign has_live_trip = true
  endif

  assign overview_kicker = section.settings.demo_trip_kicker
  assign overview_title = section.settings.demo_trip_title
  assign overview_dates = section.settings.demo_trip_dates
  assign overview_status = section.settings.demo_trip_status
  assign overview_summary = section.settings.demo_trip_summary
  assign overview_button_label = section.settings.demo_trip_button_label
  assign overview_button_link = section.settings.demo_trip_button_link

  if trip_record != blank
    assign overview_kicker = 'Upcoming trip'
    assign overview_title = trip_title | default: section.settings.demo_trip_title
    assign overview_status = booking_status | default: section.settings.demo_trip_status
    assign overview_summary = trip_overview | default: section.settings.demo_trip_summary
    assign overview_button_label = 'Open trip details'
    assign overview_button_link = pages['your-trip'].url | default: '/pages/your-trip'

    capture overview_dates
      if trip_start_date != blank
        echo trip_start_date | date: '%B %-d, %Y'
        if trip_end_date != blank
          echo ' to '
          echo trip_end_date | date: '%B %-d, %Y'
        endif
      endif
    endcapture
  endif

  if section.settings.enable_travefy_embed and travefy_itinerary_id != blank
    assign show_travefy_embed = true
  endif

  if page_key == 'hub'
    if customer and customer.first_name != blank
      assign heading_text = 'Welcome back, ' | append: customer.first_name
    elsif customer
      assign heading_text = 'Welcome back'
    endif
  endif
-%}

{% capture protected_content %}
  <div
    class="portal-shell"
    data-portal-root
    data-portal-proxy-url="{{ section.settings.portal_data_proxy_path | escape }}"
    data-portal-customer-id="{% if customer %}{{ customer.id }}{% endif %}"
    data-portal-trip-page-url="{{ pages['your-trip'].url | default: '/pages/your-trip' }}"
  >
    {% render 'portal-nav', current_handle: current_handle %}

    <header class="portal-hero">
      {% if section.settings.eyebrow != blank %}
        <p class="portal-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <div class="portal-hero__layout">
        <div class="portal-hero__main">
          <h1 class="portal-hero__heading h0">{{ heading_text }}</h1>
          {% if intro_text != blank %}
            <div class="portal-hero__intro rte">{{ intro_text }}</div>
          {% endif %}
        </div>
        <div class="portal-hero__badge">
          <span class="portal-hero__badge-icon">{% render 'portal-icon', icon: 'sparkle' %}</span>
          <div>
            <p class="portal-hero__badge-label">Phase 1 portal</p>
            <p class="portal-hero__badge-copy">Theme-native, login-gated, and ready for future data sources.</p>
          </div>
        </div>
      </div>
    </header>

    <div class="portal-note rte" data-portal-loading hidden>
      <p>Loading your latest client information.</p>
    </div>
    <div class="portal-note rte" data-portal-error hidden></div>

    {% if page_key == 'hub' %}
      <div class="portal-dashboard">
        {% if quick_action_count > 0 %}
          <section class="portal-quick-actions" aria-label="Quick actions">
            {% for block in section.blocks %}
              {% if block.type != 'quick_action' %}
                {% continue %}
              {% endif %}
              <article class="portal-quick-action" {{ block.shopify_attributes }}>
                <div class="portal-quick-action__icon">
                  {% render 'portal-icon', icon: block.settings.icon %}
                </div>
                <div class="portal-quick-action__content">
                  <p class="portal-quick-action__eyebrow">{{ block.settings.eyebrow }}</p>
                  <h2 class="portal-quick-action__title h5">{{ block.settings.title }}</h2>
                </div>
                {% if block.settings.link != blank %}
                  <a class="portal-quick-action__link" href="{{ block.settings.link }}" aria-label="{{ block.settings.title }}">
                    <span class="visually-hidden">{{ block.settings.link_label | default: block.settings.title }}</span>
                    {% render 'portal-icon', icon: 'arrow' %}
                  </a>
                {% endif %}
              </article>
            {% endfor %}
          </section>
        {% endif %}

        <section class="portal-hero-card portal-hero-card--trip" data-portal-live-trip hidden>
          <div class="portal-hero-card__main">
            <div class="portal-hero-card__icon">
              {% render 'portal-icon', icon: 'plane' %}
            </div>
            <p class="portal-hero-card__eyebrow">Upcoming trip</p>
            <h2 class="portal-hero-card__title h1" data-portal-live-trip-title>Your trip</h2>
            <div class="portal-hero-card__copy rte">
              <p data-portal-live-trip-summary>Your Salesforce trip summary will appear here.</p>
            </div>
            <div class="portal-hero-card__pills">
              <span class="portal-pill" data-portal-live-trip-dates hidden></span>
              <span class="portal-pill portal-pill--accent" data-portal-live-trip-status hidden></span>
            </div>
          </div>
          <div class="portal-hero-card__aside">
            <div class="portal-hero-stat">
              <span class="portal-hero-stat__icon">{% render 'portal-icon', icon: 'star' %}</span>
              <div>
                <p class="portal-hero-stat__label">Support</p>
                <p class="portal-hero-stat__value" data-portal-live-trip-support>Concierge team</p>
              </div>
            </div>
          </div>
        </section>

        {% if has_live_trip %}
          <section class="portal-hero-card portal-hero-card--trip" data-portal-fallback-trip>
            <div class="portal-hero-card__main">
              <div class="portal-hero-card__icon">
                {% render 'portal-icon', icon: 'plane' %}
              </div>
              <p class="portal-hero-card__eyebrow">{{ overview_kicker }}</p>
              <h2 class="portal-hero-card__title h1">{{ overview_title }}</h2>
              {% if overview_summary != blank %}
                <div class="portal-hero-card__copy rte">{{ overview_summary }}</div>
              {% endif %}
              <div class="portal-hero-card__pills">
                {% if overview_dates != blank %}
                  <span class="portal-pill">
                    {% render 'portal-icon', icon: 'calendar' %}
                    {{ overview_dates }}
                  </span>
                {% endif %}
                {% if overview_status != blank %}
                  <span class="portal-pill portal-pill--accent">
                    {% render 'portal-icon', icon: 'sparkle' %}
                    {{ overview_status }}
                  </span>
                {% endif %}
                <span class="portal-pill">
                  {% render 'portal-icon', icon: 'compass' %}
                  Placeholder concierge view
                </span>
              </div>
              {% if overview_button_link != blank and overview_button_label != blank %}
                <div class="portal-hero-card__actions">
                  <a class="button portal-button" href="{{ overview_button_link }}">{{ overview_button_label }}</a>
                </div>
              {% endif %}
            </div>
            <div class="portal-hero-card__aside">
              <div class="portal-hero-stat">
                <span class="portal-hero-stat__icon">{% render 'portal-icon', icon: 'map' %}</span>
                <div>
                  <p class="portal-hero-stat__label">Portal focus</p>
                  <p class="portal-hero-stat__value">Upcoming trip</p>
                </div>
              </div>
              <div class="portal-hero-stat">
                <span class="portal-hero-stat__icon">{% render 'portal-icon', icon: 'ticket' %}</span>
                <div>
                  <p class="portal-hero-stat__label">Linked modules</p>
                  <p class="portal-hero-stat__value">Tickets, forms, payments</p>
                </div>
              </div>
              <div class="portal-hero-stat">
                <span class="portal-hero-stat__icon">{% render 'portal-icon', icon: 'star' %}</span>
                <div>
                  <p class="portal-hero-stat__label">Support</p>
                  <p class="portal-hero-stat__value">
                    {% if support_email != blank %}
                      <a href="mailto:{{ support_email }}">{{ support_email }}</a>
                    {% elsif advisor_name != blank %}
                      {{ advisor_name }}
                    {% else %}
                      Concierge placeholder
                    {% endif %}
                  </p>
                </div>
              </div>
            </div>
          </section>
        {% else %}
          <section class="portal-empty-state" role="status" data-portal-fallback-trip>
            <div class="portal-empty-state__art">
              <span class="portal-empty-state__art-ring"></span>
              <span class="portal-empty-state__art-icon">{% render 'portal-icon', icon: 'suitcase' %}</span>
            </div>
            <div class="portal-empty-state__content">
              <p class="portal-empty-state__eyebrow">No active trip yet</p>
              <h2 class="portal-empty-state__title h2">{{ section.settings.empty_state_heading }}</h2>
              <div class="portal-empty-state__copy rte">{{ section.settings.empty_state_body }}</div>
              <div class="portal-empty-state__actions">
                {% if section.settings.empty_primary_label != blank and section.settings.empty_primary_link != blank %}
                  <a class="button portal-button" href="{{ section.settings.empty_primary_link }}">{{ section.settings.empty_primary_label }}</a>
                {% endif %}
                {% if section.settings.empty_secondary_label != blank and section.settings.empty_secondary_link != blank %}
                  <a class="button button--secondary portal-button portal-button--secondary" href="{{ section.settings.empty_secondary_link }}">{{ section.settings.empty_secondary_label }}</a>
                {% endif %}
                {% if section.settings.empty_tertiary_label != blank and section.settings.empty_tertiary_link != blank %}
                  <a class="portal-text-link" href="{{ section.settings.empty_tertiary_link }}">
                    {% render 'portal-icon', icon: 'compass' %}
                    {{ section.settings.empty_tertiary_label }}
                  </a>
                {% endif %}
              </div>
            </div>
          </section>
        {% endif %}

        {% if quick_link_count > 0 %}
          <section class="portal-section portal-section--links">
            <div class="portal-section__header">
              <div>
                <p class="portal-section__eyebrow">Quick links</p>
                <h2 class="portal-section__title h2">{{ section.settings.quick_links_heading }}</h2>
              </div>
              <p class="portal-section__copy">Keep the most-used portal destinations one click away.</p>
            </div>
            <div class="portal-link-grid">
              {% for block in section.blocks %}
                {% if block.type != 'quick_link' %}
                  {% continue %}
                {% endif %}
                <a class="portal-link-tile" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
                  <span class="portal-link-tile__icon">{% render 'portal-icon', icon: block.settings.icon %}</span>
                  <span class="portal-link-tile__text">{{ block.settings.title }}</span>
                  <span class="portal-link-tile__arrow">{% render 'portal-icon', icon: 'arrow' %}</span>
                </a>
              {% endfor %}
            </div>
          </section>
        {% endif %}

        <section class="portal-section">
          <div class="portal-section__header">
            <div>
              <p class="portal-section__eyebrow">Profile</p>
              <h2 class="portal-section__title h2">Update your details</h2>
            </div>
            <p class="portal-section__copy">Changes saved here update Salesforce directly and mirror to Shopify when possible.</p>
          </div>
          <form class="portal-profile-form" data-portal-profile-form>
            <div class="portal-profile-form__grid">
              <label><span>First name</span><input type="text" data-portal-profile-first-name></label>
              <label><span>Last name</span><input type="text" data-portal-profile-last-name></label>
              <label><span>Email</span><input type="email" data-portal-profile-email></label>
              <label><span>Phone</span><input type="tel" data-portal-profile-phone></label>
              <label><span>Address line 1</span><input type="text" data-portal-profile-address1></label>
              <label><span>Address line 2</span><input type="text" data-portal-profile-address2></label>
              <label><span>City</span><input type="text" data-portal-profile-city></label>
              <label><span>State</span><input type="text" data-portal-profile-state></label>
              <label><span>Postal code</span><input type="text" data-portal-profile-postal></label>
              <label><span>Country</span><input type="text" data-portal-profile-country></label>
            </div>
            <div class="portal-profile-form__actions">
              <button class="button portal-button" type="submit">Save details</button>
              <p class="portal-profile-form__status" data-portal-profile-status hidden></p>
            </div>
          </form>
        </section>

        <section class="portal-section" data-portal-trips-section hidden>
          <div class="portal-section__header">
            <div>
              <p class="portal-section__eyebrow">Trip collection</p>
              <h2 class="portal-section__title h2">Your trips</h2>
            </div>
            <p class="portal-section__copy">Live trip memberships synced from Salesforce.</p>
          </div>
          <div class="portal-dashboard-grid" data-portal-trips-list></div>
        </section>

        <section class="portal-section" data-portal-household-section hidden>
          <div class="portal-section__header">
            <div>
              <p class="portal-section__eyebrow">Household</p>
              <h2 class="portal-section__title h2">Connected travellers</h2>
            </div>
            <p class="portal-section__copy" data-portal-household-name></p>
          </div>
          <div class="portal-dashboard-grid" data-portal-household-members></div>
        </section>

        {% if dashboard_card_count > 0 %}
          <section class="portal-section">
            <div class="portal-section__header">
              <div>
                <p class="portal-section__eyebrow">Portal areas</p>
                <h2 class="portal-section__title h2">{{ section.settings.dashboard_heading }}</h2>
              </div>
              <p class="portal-section__copy">These cards are placeholders today and can later swap to metafields, metaobjects, or external systems.</p>
            </div>
            <div class="portal-dashboard-grid">
              {% for block in section.blocks %}
                {% unless block.type == 'dashboard_card' or block.type == 'portal_card' %}
                  {% continue %}
                {% endunless %}
                <article class="portal-dashboard-card" {{ block.shopify_attributes }}>
                  <div class="portal-dashboard-card__top">
                    <span class="portal-dashboard-card__icon">{% render 'portal-icon', icon: block.settings.icon | default: 'sparkle' %}</span>
                    {% if block.settings.status != blank %}
                      <span class="portal-dashboard-card__status">{{ block.settings.status }}</span>
                    {% endif %}
                  </div>
                  <p class="portal-dashboard-card__eyebrow">{{ block.settings.eyebrow | default: 'Portal area' }}</p>
                  <h3 class="portal-dashboard-card__title h4">{{ block.settings.title }}</h3>
                  {% if block.settings.description != blank %}
                    <div class="portal-dashboard-card__copy rte">{{ block.settings.description }}</div>
                  {% endif %}
                  {% if block.settings.link != blank %}
                    <div class="portal-dashboard-card__actions">
                      <a class="portal-text-link" href="{{ block.settings.link }}">
                        {{ block.settings.link_label | default: 'Open' }}
                        {% render 'portal-icon', icon: 'arrow' %}
                      </a>
                    </div>
                  {% endif %}
                </article>
              {% endfor %}
            </div>
          </section>
        {% endif %}

        {% if section.settings.enable_travefy_embed %}
          <section class="portal-section portal-section--embed">
            <div class="portal-section__header">
              <div>
                <p class="portal-section__eyebrow">{{ section.settings.travefy_eyebrow }}</p>
                <h2 class="portal-section__title h2">{{ section.settings.travefy_heading }}</h2>
              </div>
              {% if section.settings.travefy_intro != blank %}
                <div class="portal-section__copy rte">{{ section.settings.travefy_intro }}</div>
              {% endif %}
            </div>

            {% if show_travefy_embed %}
              <div class="portal-travefy-embed">
                <div
                  class="travefy-itinerary"
                  data-travefy-itinerary-id="{{ travefy_itinerary_id | escape }}"
                ></div>
              </div>
            {% else %}
              <div class="portal-note rte">
                {{ section.settings.travefy_empty_message }}
              </div>
            {% endif %}
          </section>
        {% endif %}

        {% if next_step_count > 0 %}
          <section class="portal-section">
            <div class="portal-section__header">
              <div>
                <p class="portal-section__eyebrow">Action list</p>
                <h2 class="portal-section__title h2">{{ section.settings.next_steps_heading }}</h2>
              </div>
              {% if section.settings.next_steps_intro != blank %}
                <div class="portal-section__copy rte">{{ section.settings.next_steps_intro }}</div>
              {% endif %}
            </div>
            <div class="portal-step-list">
              {% assign next_step_index = 0 %}
              {% for block in section.blocks %}
                {% if block.type != 'next_step' %}
                  {% continue %}
                {% endif %}
                {% assign next_step_index = next_step_index | plus: 1 %}
                <article class="portal-step" {{ block.shopify_attributes }}>
                  <div class="portal-step__number">
                    {% if next_step_index < 10 %}0{% endif %}{{ next_step_index }}
                  </div>
                  <div class="portal-step__content">
                    <div class="portal-step__icon">{% render 'portal-icon', icon: block.settings.icon %}</div>
                    <div>
                      <h3 class="portal-step__title h5">{{ block.settings.title }}</h3>
                      {% if block.settings.description != blank %}
                        <div class="portal-step__copy rte">{{ block.settings.description }}</div>
                      {% endif %}
                    </div>
                  </div>
                  {% if block.settings.link != blank %}
                    <div class="portal-step__actions">
                      <a class="button button--secondary portal-button portal-button--secondary" href="{{ block.settings.link }}">
                        {{ block.settings.link_label | default: 'Open' }}
                      </a>
                    </div>
                  {% endif %}
                </article>
              {% endfor %}
            </div>
          </section>
        {% endif %}

        <section class="portal-section">
          <div class="portal-section__header">
            <div>
              <p class="portal-section__eyebrow">Archive</p>
              <h2 class="portal-section__title h2">{{ section.settings.past_trips_heading }}</h2>
            </div>
            {% if section.settings.past_trips_intro != blank %}
              <div class="portal-section__copy rte">{{ section.settings.past_trips_intro }}</div>
            {% endif %}
          </div>
          {% if past_trip_count > 0 %}
            <div class="portal-past-trips">
              {% for block in section.blocks %}
                {% if block.type != 'past_trip' %}
                  {% continue %}
                {% endif %}
                <article class="portal-past-trip" {{ block.shopify_attributes }}>
                  <div class="portal-past-trip__top">
                    <p class="portal-past-trip__dates">{{ block.settings.dates }}</p>
                    <span class="portal-past-trip__icon">{% render 'portal-icon', icon: block.settings.icon %}</span>
                  </div>
                  <h3 class="portal-past-trip__title h4">{{ block.settings.title }}</h3>
                  {% if block.settings.description != blank %}
                    <div class="portal-past-trip__copy rte">{{ block.settings.description }}</div>
                  {% endif %}
                  {% if block.settings.link != blank %}
                    <a class="portal-text-link" href="{{ block.settings.link }}">
                      {{ block.settings.link_label | default: 'View details' }}
                      {% render 'portal-icon', icon: 'arrow' %}
                    </a>
                  {% endif %}
                </article>
              {% endfor %}
            </div>
          {% else %}
            <div class="portal-note rte">
              <p>Past trips will appear here once you add them as section blocks or connect customer trip data later.</p>
            </div>
          {% endif %}
        </section>

        {% if section.settings.cta_heading != blank or section.settings.cta_button_label != blank %}
          <section class="portal-cta">
            <div class="portal-cta__content">
              <p class="portal-cta__eyebrow">Next adventure</p>
              {% if section.settings.cta_heading != blank %}
                <h2 class="portal-cta__title h2">{{ section.settings.cta_heading }}</h2>
              {% endif %}
              {% if section.settings.cta_body != blank %}
                <div class="portal-cta__copy rte">{{ section.settings.cta_body }}</div>
              {% endif %}
            </div>
            {% if section.settings.cta_button_label != blank and section.settings.cta_button_link != blank %}
              <div class="portal-cta__actions">
                <a class="button portal-button" href="{{ section.settings.cta_button_link }}">{{ section.settings.cta_button_label }}</a>
              </div>
            {% endif %}
          </section>
        {% endif %}
      </div>
    {% endif %}

    {% if page_key == 'trip' %}
      <section class="portal-section" data-portal-trip-page-live hidden>
        <div class="portal-section__header">
          <div>
            <p class="portal-section__eyebrow">Live trip</p>
            <h2 class="portal-section__title h2" data-portal-trip-page-title>Your trip</h2>
          </div>
          <p class="portal-section__copy" data-portal-trip-page-dates></p>
        </div>
        <div class="portal-grid portal-grid--stats">
          <article class="portal-stat">
            <p class="portal-stat__label">Booking status</p>
            <p class="portal-stat__value h2" data-portal-trip-page-booking-status></p>
          </article>
          <article class="portal-stat">
            <p class="portal-stat__label">Supplier</p>
            <p class="portal-stat__value h2" data-portal-trip-page-supplier></p>
          </article>
          <article class="portal-stat">
            <p class="portal-stat__label">Support</p>
            <p class="portal-stat__value h5" data-portal-trip-page-support></p>
          </article>
        </div>
        <div class="portal-dashboard-grid">
          <article class="portal-dashboard-card">
            <p class="portal-dashboard-card__eyebrow">Trip type</p>
            <h3 class="portal-dashboard-card__title h4" data-portal-trip-page-type></h3>
          </article>
          <article class="portal-dashboard-card">
            <p class="portal-dashboard-card__eyebrow">Booking reference</p>
            <h3 class="portal-dashboard-card__title h4" data-portal-trip-page-reference></h3>
          </article>
          <article class="portal-dashboard-card">
            <p class="portal-dashboard-card__eyebrow">Travellers</p>
            <h3 class="portal-dashboard-card__title h4" data-portal-trip-page-travellers></h3>
          </article>
        </div>
      </section>

      {% if trip_record != blank %}
        <div class="portal-grid portal-grid--stats" data-portal-trip-page-fallback>
          <article class="portal-stat">
            <p class="portal-stat__label">Trip title</p>
            <p class="portal-stat__value h2">{{ trip_title | default: 'Your trip' }}</p>
            <p class="portal-stat__meta">
              {% if trip_start_date != blank %}
                {{ trip_start_date | date: '%B %-d, %Y' }}
              {% else %}
                Add trip dates when ready.
              {% endif %}
            </p>
          </article>
          <article class="portal-stat">
            <p class="portal-stat__label">Booking status</p>
            <p class="portal-stat__value h2">{{ booking_status | default: 'Pending' }}</p>
            <p class="portal-stat__meta">
              {% if advisor_name != blank %}
                Managed by {{ advisor_name }}
              {% else %}
                Assign an advisor later.
              {% endif %}
            </p>
          </article>
          <article class="portal-stat">
            <p class="portal-stat__label">Support</p>
            <p class="portal-stat__value h5">
              {% if support_email != blank %}
                <a href="mailto:{{ support_email }}">{{ support_email }}</a>
              {% else %}
                Contact to be added
              {% endif %}
            </p>
            <p class="portal-stat__meta">Reserved for future synced trip data.</p>
          </article>
        </div>
      {% endif %}

      {% if info_panel_count > 0 %}
        <div class="portal-grid portal-grid--panels" data-portal-trip-page-fallback>
          {% for block in section.blocks %}
            {% if block.type != 'info_panel' %}
              {% continue %}
            {% endif %}
            {% assign panel_body = block.settings.body %}
            {% assign panel_classes = 'portal-panel' %}
            {% if block.settings.width == 'full' %}
              {% assign panel_classes = panel_classes | append: ' portal-panel--full' %}
            {% endif %}
            {% if trip_record != blank %}
              {% case block.settings.title %}
                {% when 'Trip Overview' %}
                  {% assign panel_body = trip_overview | default: block.settings.body %}
                {% when 'Booking Status' %}
                  {% capture panel_body %}
                    <p>{{ booking_status | default: 'No booking status has been added yet.' }}</p>
                    {% if trip_start_date != blank %}
                      <p>Departure: {{ trip_start_date | date: '%B %-d, %Y' }}</p>
                    {% endif %}
                    {% if trip_end_date != blank %}
                      <p>Return: {{ trip_end_date | date: '%B %-d, %Y' }}</p>
                    {% endif %}
                  {% endcapture %}
                {% when 'Upcoming Plans' %}
                  {% assign panel_body = upcoming_plans | default: block.settings.body %}
                {% when 'Future Salesforce / Itinerary Integration' %}
                  {% assign panel_body = salesforce_placeholder | default: block.settings.body %}
              {% endcase %}
            {% endif %}
            <article class="{{ panel_classes }}" {{ block.shopify_attributes }}>
              <h2 class="portal-panel__title h3">{{ block.settings.title }}</h2>
              {% if panel_body != blank %}
                <div class="portal-panel__body rte">{{ panel_body }}</div>
              {% endif %}
            </article>
          {% endfor %}
        </div>
      {% endif %}

      {% if section.settings.enable_travefy_embed %}
        <section class="portal-section portal-section--embed">
          <div class="portal-section__header">
            <div>
              <p class="portal-section__eyebrow">{{ section.settings.travefy_eyebrow }}</p>
              <h2 class="portal-section__title h2">{{ section.settings.travefy_heading }}</h2>
            </div>
            {% if section.settings.travefy_intro != blank %}
              <div class="portal-section__copy rte">{{ section.settings.travefy_intro }}</div>
            {% endif %}
          </div>

          {% if show_travefy_embed %}
            <div class="portal-travefy-embed">
              <div
                class="travefy-itinerary"
                data-travefy-itinerary-id="{{ travefy_itinerary_id | escape }}"
              ></div>
            </div>
          {% else %}
            <div class="portal-note rte">
              {{ section.settings.travefy_empty_message }}
            </div>
          {% endif %}
        </section>
      {% endif %}

      {% if trip_record == blank %}
        <div class="portal-note rte" data-portal-trip-page-fallback>
          <p>No trip record is assigned to this customer yet.</p>
          <p>Add a future metafield or metaobject later and this page can populate without changing the template.</p>
        </div>
      {% endif %}
    {% endif %}

    {% if page_key == 'shop' %}
      <div class="portal-grid portal-grid--stats">
        <article class="portal-stat">
          <p class="portal-stat__label">Available credits</p>
          <p class="portal-stat__value" data-portal-credit-balance>{{ credit_balance }}</p>
          <p class="portal-stat__meta" data-portal-credit-value>{{ credit_balance_cents | money_without_trailing_zeros }} equivalent</p>
        </article>
        <article class="portal-stat">
          <p class="portal-stat__label">Member discount</p>
          <p class="portal-stat__value" data-portal-discount-percent>
            {% if discount_percent != blank %}
              {{ discount_percent }}%
            {% else %}
              TBC
            {% endif %}
          </p>
          <p class="portal-stat__meta">Reserved for future synced discount logic.</p>
        </article>
        <article class="portal-stat">
          <p class="portal-stat__label">Credit conversion</p>
          <p class="portal-stat__value">10</p>
          <p class="portal-stat__meta">1 credit = {{ 10 | money_without_trailing_zeros }} in reward value.</p>
        </article>
      </div>

      {% if secret_shop_collection != blank and secret_shop_collection.products_count > 0 %}
        {% assign secret_shop_has_products = true %}
        <div class="portal-shop">
          <div class="portal-shop__header">
            <div>
              <p class="portal-section__eyebrow">{{ section.settings.secret_shop_collection_label }}</p>
              <h2 class="h2">{{ secret_shop_collection.title }}</h2>
            </div>
            <div class="portal-shop__meta rte">{{ section.settings.secret_shop_helper_text }}</div>
          </div>
          <div class="portal-shop__grid">
            {% for product in secret_shop_collection.products limit: secret_shop_products_limit %}
              {% assign credit_cost = 0 %}
              {% assign credit_cost_cents = 0 %}
              {% if product.metafields.portal.credit_cost != blank and product.metafields.portal.credit_cost.value != blank %}
                {% assign credit_cost = product.metafields.portal.credit_cost.value | plus: 0 %}
                {% assign credit_cost_cents = credit_cost | times: 10 %}
              {% else %}
                {% assign credit_cost_cents = product.price %}
                {% assign credit_cost = product.price | divided_by: 10 %}
              {% endif %}
              <article
                class="portal-shop-card"
                data-portal-reward-card
                data-credit-cost="{{ credit_cost }}"
                data-portal-reward-variant-id="{{ product.selected_or_first_available_variant.id }}"
                data-portal-reward-available="{% if product.available and product.selected_or_first_available_variant != blank %}true{% else %}false{% endif %}"
              >
                <a class="portal-shop-card__media" href="{{ product.url }}">
                  {% if product.featured_image != blank %}
                    <img
                      src="{{ product.featured_image | image_url: width: 720 }}"
                      alt="{{ product.featured_image.alt | escape }}"
                      loading="lazy"
                      width="720"
                      height="540"
                    >
                  {% else %}
                    <div class="portal-shop-card__placeholder">No image</div>
                  {% endif %}
                </a>
                <div class="portal-shop-card__content">
                  <p class="portal-shop-card__eyebrow">
                    {% if product.available %}
                      Member reward
                    {% else %}
                      Currently unavailable
                    {% endif %}
                  </p>
                  <h3 class="portal-shop-card__title h4"><a href="{{ product.url }}">{{ product.title }}</a></h3>
                  {% if product.description != blank %}
                    <div class="portal-shop-card__description rte">{{ product.description | strip_html | truncatewords: 22 }}</div>
                  {% endif %}
                  <div class="portal-shop-card__pricing">
                    <p class="portal-shop-card__credits">
                      {% if credit_cost > 0 %}
                        {{ credit_cost }} credits
                      {% else %}
                        Credit cost unavailable
                      {% endif %}
                    </p>
                    <p class="portal-shop-card__money">
                      {% if credit_cost_cents > 0 %}
                        {{ credit_cost_cents | money_without_trailing_zeros }}
                      {% else %}
                        {{ product.price | money_without_trailing_zeros }}
                      {% endif %}
                    </p>
                  </div>
                  <div class="portal-shop-card__footer">
                    {% if credit_cost > 0 and credit_balance >= credit_cost %}
                      <span class="portal-shop-card__status portal-shop-card__status--available" data-portal-reward-status>Enough credits available</span>
                    {% elsif credit_cost > 0 %}
                      <span class="portal-shop-card__status" data-portal-reward-status>Additional credits required</span>
                    {% else %}
                      <span class="portal-shop-card__status" data-portal-reward-status>Check product price</span>
                    {% endif %}
                    {% if product.selected_or_first_available_variant != blank and product.available and credit_cost > 0 %}
                      <button
                        class="button portal-button"
                        type="button"
                        data-portal-redeem-button
                        {% if credit_balance < credit_cost %}disabled{% endif %}
                      >
                        Redeem with credits
                      </button>
                    {% endif %}
                    <a class="button button--secondary portal-button portal-button--secondary" href="{{ product.url }}">View reward</a>
                  </div>
                </div>
              </article>
            {% endfor %}
          </div>
        </div>
      {% endif %}

      {% if secret_shop_has_products == false %}
        <div class="portal-note rte">
          <p>No Secret Shop collection is selected yet.</p>
          <p>Choose a collection in the theme editor when you are ready to populate this member area.</p>
        </div>
      {% endif %}
    {% endif %}

    {% if section.settings.show_page_content and page.content != blank %}
      <div class="portal-page-content">
        <div class="rte">{{ page.content }}</div>
      </div>
    {% endif %}

    {% if section.settings.member_note != blank %}
      <div class="portal-note rte">{{ section.settings.member_note }}</div>
    {% endif %}
  </div>
{% endcapture %}

{% if show_travefy_embed %}
  <script>
    (function () {
      if (document.getElementById('travefy-itinerary-embedder')) {
        return;
      }

      var script = document.createElement('script');
      script.id = 'travefy-itinerary-embedder';
      script.dataset.version = 'v0';
      script.type = 'text/javascript';
      script.async = true;
      script.src = {{ section.settings.travefy_script_src | json }};

      var firstScript = document.getElementsByTagName('script')[0];
      if (firstScript && firstScript.parentNode) {
        firstScript.parentNode.insertBefore(script, firstScript);
      } else {
        document.head.appendChild(script);
      }
    })();
  </script>
{% endif %}

<section class="portal-area section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {% render 'portal-login-gate',
      title: section.settings.logged_out_title,
      message: section.settings.logged_out_message,
      button_label: section.settings.login_button_label,
      return_to: return_to,
      gated_content: protected_content
    %}
  </div>
</section>

{% schema %}
{
  "name": "Portal page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "portal_key",
      "label": "Portal page type",
      "default": "hub",
      "options": [
        { "value": "hub", "label": "Client Hub" },
        { "value": "trip", "label": "Your Trip" },
        { "value": "shop", "label": "Secret Shop" }
      ]
    },
    {
      "type": "inline_richtext",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Private client portal"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Client Hub"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text",
      "default": "<p>Your private MrChocolate dashboard gives logged-in customers one premium place to access upcoming trips, tickets, planning tools, and future client services.</p>"
    },
    {
      "type": "richtext",
      "id": "member_note",
      "label": "Member note",
      "default": "<p>Phase 1 is intentionally front-end only. This structure is ready for future customer metafields, metaobjects, and third-party integrations without rebuilding the layout.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_page_content",
      "label": "Show page body content below portal modules",
      "default": false
    },
    {
      "type": "text",
      "id": "portal_data_proxy_path",
      "label": "Portal data proxy path",
      "default": "/apps/salesforce-link/portal",
      "info": "App proxy URL used to load live Salesforce portal data for the logged-in customer."
    },
    {
      "type": "header",
      "content": "Hub content"
    },
    {
      "type": "inline_richtext",
      "id": "quick_links_heading",
      "label": "Quick links heading",
      "default": "Quick links"
    },
    {
      "type": "inline_richtext",
      "id": "dashboard_heading",
      "label": "Dashboard cards heading",
      "default": "Portal sections"
    },
    {
      "type": "header",
      "content": "Travefy embed"
    },
    {
      "type": "checkbox",
      "id": "enable_travefy_embed",
