{% comment %}
  Coeliac Traveller
{% endcomment %}
{{ 'coeliac-traveller.css' | asset_url | stylesheet_tag }}
<script src="{{ 'coeliac-traveller.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="coeliac-traveller coeliac-traveller__section coeliac-traveller__hero section-{{ section.id }}-padding">
  <div class="page-width">
    {%- liquid
      assign slide_count = section.blocks.size
      if slide_count == 0 and section.settings.image != blank
        assign slide_count = 1
      endif
    -%}

    <div class="coeliac-traveller__panel coeliac-traveller__hero-panel">
      <div
        class="coeliac-traveller__hero-slider"
        {% if slide_count > 1 %}
          data-coeliac-traveller-slider
        {% endif %}
      >
        <div class="coeliac-traveller__hero-track" {% if slide_count > 1 %}data-coeliac-traveller-track{% endif %}>
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              <article class="coeliac-traveller__hero-slide" {{ block.shopify_attributes }} {% if slide_count > 1 %}data-coeliac-traveller-slide{% endif %}>
                <div class="coeliac-traveller__hero-image">
                  {%- if block.settings.image != blank -%}
                    {{
                      block.settings.image
                      | image_url: width: 2200
                      | image_tag:
                        widths: '750, 1100, 1500, 1800, 2200',
                        sizes: '100vw',
                        alt: block.settings.image.alt | escape
                    }}
                  {%- elsif section.settings.image != blank -%}
                    {{
                      section.settings.image
                      | image_url: width: 2200
                      | image_tag:
                        widths: '750, 1100, 1500, 1800, 2200',
                        sizes: '100vw',
                        alt: section.settings.image.alt | escape
                    }}
                  {%- else -%}
                    {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
                {%- if block.settings.caption != blank -%}
                  <div class="coeliac-traveller__hero-slide-caption">{{ block.settings.caption }}</div>
                {%- endif -%}
              </article>
            {%- endfor -%}
          {%- else -%}
            <article class="coeliac-traveller__hero-slide">
              <div class="coeliac-traveller__hero-image">
                {%- if section.settings.image != blank -%}
                  {{
                    section.settings.image
                    | image_url: width: 2200
                    | image_tag:
                      widths: '750, 1100, 1500, 1800, 2200',
                      sizes: '100vw',
                      alt: section.settings.image.alt | escape
                  }}
                {%- else -%}
                  {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
            </article>
          {%- endif -%}
        </div>

        <div class="coeliac-traveller__hero-overlay">
          <div class="coeliac-traveller__hero-copy">
            {%- if section.settings.eyebrow != blank -%}
              <p class="coeliac-traveller__eyebrow">{{ section.settings.eyebrow }}</p>
            {%- endif -%}

            {%- if section.settings.heading != blank -%}
              <h1 class="coeliac-traveller__heading">{{ section.settings.heading }}</h1>
            {%- endif -%}

            {%- if section.settings.subheading != blank -%}
              <div class="coeliac-traveller__body rte">
                {{ section.settings.subheading }}
              </div>
            {%- endif -%}

            <div class="coeliac-traveller__hero-meta">
              {%- if section.settings.meta_one != blank -%}
                <span class="coeliac-traveller__pill">{{ section.settings.meta_one }}</span>
              {%- endif -%}
              {%- if section.settings.meta_two != blank -%}
                <span class="coeliac-traveller__pill">{{ section.settings.meta_two }}</span>
              {%- endif -%}
              {%- if section.settings.meta_three != blank -%}
                <span class="coeliac-traveller__pill">{{ section.settings.meta_three }}</span>
              {%- endif -%}
            </div>

            <div class="coeliac-traveller__actions">
              {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
                <a class="coeliac-traveller__button" href="{{ section.settings.button_link }}">
                  {{ section.settings.button_label }}
                </a>
              {%- endif -%}
              {%- if section.settings.secondary_button_label != blank and section.settings.secondary_button_link != blank -%}
                <a class="coeliac-traveller__button coeliac-traveller__button--secondary" href="{{ section.settings.secondary_button_link }}">
                  {{ section.settings.secondary_button_label }}
                </a>
              {%- endif -%}
            </div>
          </div>

          {%- if slide_count > 1 -%}
            <div class="coeliac-traveller__hero-controls">
              <div class="coeliac-traveller__hero-arrows">
                <button class="coeliac-traveller__hero-arrow" type="button" aria-label="Previous slide" data-coeliac-traveller-prev>
                  <span aria-hidden="true">‹</span>
                </button>
                <button class="coeliac-traveller__hero-arrow" type="button" aria-label="Next slide" data-coeliac-traveller-next>
                  <span aria-hidden="true">›</span>
                </button>
              </div>

              <div class="coeliac-traveller__hero-dots">
                {%- for block in section.blocks -%}
                  <button
                    class="coeliac-traveller__hero-dot{% if forloop.first %} is-active{% endif %}"
                    type="button"
                    aria-label="Go to slide {{ forloop.index }}"
                    {% if forloop.first %}aria-current="true"{% else %}aria-current="false"{% endif %}
                    data-coeliac-traveller-dot
                  ></button>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Coeliac Traveller hero",
  "tag": "section",
  "class": "section section-coeliac-traveller-hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Coeliac Traveller"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Gluten free travel with a softer, smarter guide"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Intro text",
      "default": "<p>Share destination ideas, practical travel tips, favourite finds, and easy recommendations for coeliac travellers and gluten free families.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback image"
    },
    {
      "type": "text",
      "id": "meta_one",
      "label": "Meta pill 1",
      "default": "Travel guides"
    },
    {
      "type": "text",
      "id": "meta_two",
      "label": "Meta pill 2",
      "default": "Gluten free tips"
    },
    {
      "type": "text",
      "id": "meta_three",
      "label": "Meta pill 3",
      "default": "Products we love"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label",
      "default": "Explore the guide"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label",
      "default": "Join the newsletter"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Hero slide",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Coeliac Traveller hero",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
