{%- liquid
  assign current_title = current_title | default: '' | strip
  assign current_url = current_url | default: '' | strip
  assign parent_title = parent_title | default: '' | strip
  assign parent_url = parent_url | default: '' | strip
  assign breadcrumb_position = 2
  assign breadcrumb_parent_1 = blank
  assign breadcrumb_parent_2 = blank
  assign breadcrumb_parent_3 = blank
  assign breadcrumb_parent_4 = blank
  assign breadcrumb_parent_5 = blank
  assign home_title = 'general.breadcrumbs.home' | t
  if home_title contains 'translation missing'
    assign home_title = 'Home'
  endif

  if page_object != blank
    assign breadcrumb_parent_1 = parent_page
    if breadcrumb_parent_1 == blank and page_object.metafields.custom.parent_page.value != blank
      assign breadcrumb_parent_1 = page_object.metafields.custom.parent_page.value
    endif
    if breadcrumb_parent_1 != blank and breadcrumb_parent_1.metafields.custom.parent_page.value != blank
      assign breadcrumb_parent_2 = breadcrumb_parent_1.metafields.custom.parent_page.value
    endif
    if breadcrumb_parent_2 != blank and breadcrumb_parent_2.metafields.custom.parent_page.value != blank
      assign breadcrumb_parent_3 = breadcrumb_parent_2.metafields.custom.parent_page.value
    endif
    if breadcrumb_parent_3 != blank and breadcrumb_parent_3.metafields.custom.parent_page.value != blank
      assign breadcrumb_parent_4 = breadcrumb_parent_3.metafields.custom.parent_page.value
    endif
    if breadcrumb_parent_4 != blank and breadcrumb_parent_4.metafields.custom.parent_page.value != blank
      assign breadcrumb_parent_5 = breadcrumb_parent_4.metafields.custom.parent_page.value
    endif
  endif
-%}

{%- if current_title != blank -%}
  <nav class="breadcrumbs page-width{% if narrow %} page-width--narrow{% endif %}" aria-label="Breadcrumb">
    <ol class="breadcrumbs__list list-unstyled">
      <li class="breadcrumbs__item">
        <a class="breadcrumbs__link link" href="{{ routes.root_url }}">{{ home_title | escape }}</a>
      </li>
      {%- if page_object != blank -%}
        {%- if breadcrumb_parent_5 != blank -%}
          <li class="breadcrumbs__item" aria-hidden="true"><span class="breadcrumbs__separator">/</span></li>
          <li class="breadcrumbs__item"><a class="breadcrumbs__link link" href="{{ breadcrumb_parent_5.url }}">{{ breadcrumb_parent_5.title | escape }}</a></li>
        {%- endif -%}
        {%- if breadcrumb_parent_4 != blank -%}
          <li class="breadcrumbs__item" aria-hidden="true"><span class="breadcrumbs__separator">/</span></li>
          <li class="breadcrumbs__item"><a class="breadcrumbs__link link" href="{{ breadcrumb_parent_4.url }}">{{ breadcrumb_parent_4.title | escape }}</a></li>
        {%- endif -%}
        {%- if breadcrumb_parent_3 != blank -%}
          <li class="breadcrumbs__item" aria-hidden="true"><span class="breadcrumbs__separator">/</span></li>
          <li class="breadcrumbs__item"><a class="breadcrumbs__link link" href="{{ breadcrumb_parent_3.url }}">{{ breadcrumb_parent_3.title | escape }}</a></li>
        {%- endif -%}
        {%- if breadcrumb_parent_2 != blank -%}
          <li class="breadcrumbs__item" aria-hidden="true"><span class="breadcrumbs__separator">/</span></li>
          <li class="breadcrumbs__item"><a class="breadcrumbs__link link" href="{{ breadcrumb_parent_2.url }}">{{ breadcrumb_parent_2.title | escape }}</a></li>
        {%- endif -%}
        {%- if breadcrumb_parent_1 != blank -%}
          <li class="breadcrumbs__item" aria-hidden="true"><span class="breadcrumbs__separator">/</span></li>
          <li class="breadcrumbs__item"><a class="breadcrumbs__link link" href="{{ breadcrumb_parent_1.url }}">{{ breadcrumb_parent_1.title | escape }}</a></li>
        {%- endif -%}
      {%- elsif parent_title != blank and parent_url != blank -%}
        <li class="breadcrumbs__item" aria-hidden="true">
          <span class="breadcrumbs__separator">/</span>
        </li>
        <li class="breadcrumbs__item">
          <a class="breadcrumbs__link link" href="{{ parent_url }}">{{ parent_title | escape }}</a>
        </li>
      {%- endif -%}
      <li class="breadcrumbs__item" aria-hidden="true">
        <span class="breadcrumbs__separator">/</span>
      </li>
      <li class="breadcrumbs__item">
        <span class="breadcrumbs__current" aria-current="page">{{ current_title | escape }}</span>
      </li>
    </ol>
  </nav>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ home_title | json }},
          "item": {{ request.origin | append: routes.root_url | json }}
        }
        {%- if page_object != blank -%}
          {%- if breadcrumb_parent_5 != blank -%}
            ,
            {
              "@type": "ListItem",
              "position": {{ breadcrumb_position }},
              "name": {{ breadcrumb_parent_5.title | json }},
              "item": {{ request.origin | append: breadcrumb_parent_5.url | json }}
            }
            {%- assign breadcrumb_position = breadcrumb_position | plus: 1 -%}
          {%- endif -%}
          {%- if breadcrumb_parent_4 != blank -%}
            ,
            {
              "@type": "ListItem",
              "position": {{ breadcrumb_position }},
              "name": {{ breadcrumb_parent_4.title | json }},
              "item": {{ request.origin | append: breadcrumb_parent_4.url | json }}
            }
            {%- assign breadcrumb_position = breadcrumb_position | plus: 1 -%}
          {%- endif -%}
          {%- if breadcrumb_parent_3 != blank -%}
            ,
            {
              "@type": "ListItem",
              "position": {{ breadcrumb_position }},
              "name": {{ breadcrumb_parent_3.title | json }},
              "item": {{ request.origin | append: breadcrumb_parent_3.url | json }}
            }
            {%- assign breadcrumb_position = breadcrumb_position | plus: 1 -%}
          {%- endif -%}
          {%- if breadcrumb_parent_2 != blank -%}
            ,
            {
              "@type": "ListItem",
              "position": {{ breadcrumb_position }},
              "name": {{ breadcrumb_parent_2.title | json }},
              "item": {{ request.origin | append: breadcrumb_parent_2.url | json }}
            }
            {%- assign breadcrumb_position = breadcrumb_position | plus: 1 -%}
          {%- endif -%}
          {%- if breadcrumb_parent_1 != blank -%}
            ,
            {
              "@type": "ListItem",
              "position": {{ breadcrumb_position }},
              "name": {{ breadcrumb_parent_1.title | json }},
              "item": {{ request.origin | append: breadcrumb_parent_1.url | json }}
            }
            {%- assign breadcrumb_position = breadcrumb_position | plus: 1 -%}
          {%- endif -%}
          ,
          {
            "@type": "ListItem",
            "position": {{ breadcrumb_position }},
            "name": {{ current_title | json }},
            "item": {{ current_url | json }}
          }
        {%- elsif parent_title != blank and parent_url != blank -%}
          ,
          {
            "@type": "ListItem",
            "position": 2,
            "name": {{ parent_title | json }},
            "item": {{ parent_url | json }}
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": {{ current_title | json }},
            "item": {{ current_url | json }}
          }
        {%- else -%}
          ,
          {
            "@type": "ListItem",
            "position": 2,
            "name": {{ current_title | json }},
            "item": {{ current_url | json }}
          }
        {%- endif -%}
      ]
    }
  </script>
{%- endif -%}
