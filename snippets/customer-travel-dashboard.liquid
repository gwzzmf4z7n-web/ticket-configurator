<section class="travel-portal-dashboard" aria-labelledby="TravelPortalHeading">
  <div class="travel-portal-dashboard__header">
    <div>
      <p class="travel-portal-dashboard__eyebrow">MrChocolate Travel Portal</p>
      <h2 id="TravelPortalHeading" class="travel-portal-dashboard__title">
        {% if trip_name != blank %}
          {{ trip_name }}
        {% else %}
          Your next adventure
        {% endif %}
      </h2>
      <div class="travel-portal-dashboard__meta">
        {% if customer_email != blank %}
          <span>{{ customer_email }}</span>
        {% endif %}
        {% if booking_number != blank %}
          <span>Booking {{ booking_number }}</span>
        {% endif %}
      </div>
    </div>

    <div class="travel-portal-dashboard__actions">
      {% if travefy_itinerary_link != blank %}
        <a
          class="button button--primary"
          href="{{ travefy_itinerary_link }}"
          target="_blank"
          rel="noopener noreferrer"
        >
          View itinerary
        </a>
      {% endif %}

      {% if rewards_enabled and rewards_store_url != blank %}
        <a class="button button--secondary" href="{{ rewards_store_url }}">
          Rewards store
        </a>
      {% endif %}
    </div>
  </div>

  <div class="travel-portal-dashboard__grid">
    <article class="travel-portal-card travel-portal-card--hero">
      <p class="travel-portal-card__label">Trip window</p>
      <div class="travel-portal-card__value-group">
        <p class="travel-portal-card__value">
          {% if trip_start_date != blank %}
            {{ trip_start_date | time_tag: format: 'date' }}
          {% else %}
            <span>TBC</span>
          {% endif %}
        </p>
        <p class="travel-portal-card__separator">to</p>
        <p class="travel-portal-card__value">
          {% if trip_end_date != blank %}
            {{ trip_end_date | time_tag: format: 'date' }}
          {% else %}
            <span>TBC</span>
          {% endif %}
        </p>
      </div>
    </article>

    <article class="travel-portal-card">
      <p class="travel-portal-card__label">Reward credits</p>
      <p class="travel-portal-card__value">{{ credits_balance }}</p>
      <p class="travel-portal-card__hint">
        {% if rewards_enabled %}
          Credits are available for this trip.
        {% elsif trip_has_ended %}
          Credits expired when the trip ended.
        {% else %}
          Rewards access is currently unavailable.
        {% endif %}
      </p>
    </article>

    <article class="travel-portal-card">
      <p class="travel-portal-card__label">Countdown</p>
      <p class="travel-portal-card__value">
        {% if countdown_days != blank %}
          {{ countdown_days }} days
        {% elsif trip_has_ended %}
          Trip complete
        {% elsif trip_has_started %}
          In progress
        {% else %}
          TBC
        {% endif %}
      </p>
      <p class="travel-portal-card__hint">
        {% if countdown_days != blank %}
          Until departure
        {% elsif trip_has_started and trip_has_ended == false %}
          Your travel dates are underway.
        {% else %}
          Countdown updates when travel dates are set.
        {% endif %}
      </p>
    </article>

    <article class="travel-portal-card">
      <p class="travel-portal-card__label">Rewards access</p>
      <p class="travel-portal-card__value">
        {% if rewards_enabled %}
          Active
        {% else %}
          Locked
        {% endif %}
      </p>
      <p class="travel-portal-card__hint">
        {% if rewards_enabled %}
          Rewards store access stays open until the trip ends.
        {% elsif rewards_store_url == blank %}
          Add a rewards store URL in the account section settings.
        {% elsif trip_has_ended %}
          Access closes automatically after the end date.
        {% else %}
          Salesforce should set `rewards_access` to enable redemption.
        {% endif %}
      </p>
    </article>
  </div>

  {% unless rewards_enabled %}
    <div class="travel-portal-dashboard__notice" role="status">
      Rewards store access is hidden because `rewards_access` is false or the trip has ended.
    </div>
  {% endunless %}
</section>
