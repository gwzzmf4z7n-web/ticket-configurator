<section class="travel-portal-dashboard" aria-labelledby="TravelPortalHeading">
  <div class="travel-portal-dashboard__header">
    <div>
      <p class="travel-portal-dashboard__eyebrow">
        {% if portal_brand == 'magical_tickets' %}
          Magical Tickets Portal
        {% else %}
          MrChocolate Travel Portal
        {% endif %}
      </p>
      <h2 id="TravelPortalHeading" class="travel-portal-dashboard__title">
        {% if portal_title != blank %}
          {{ portal_title }}
        {% elsif trip_name != blank %}
          {{ trip_name }}
        {% else %}
          Your customer portal
        {% endif %}
      </h2>
      <div class="travel-portal-dashboard__meta">
        {% if customer_email != blank %}
          <span>{{ customer_email }}</span>
        {% endif %}
        {% if booking_number != blank %}
          <span>Reference {{ booking_number }}</span>
        {% endif %}
        {% if portal_status != blank %}
          <span>Status: {{ portal_status }}</span>
        {% endif %}
      </div>
    </div>

    {% if next_important_date != blank %}
      <div class="travel-portal-dashboard__badge">
        <span class="travel-portal-dashboard__badge-label">Next important date</span>
        <strong>{{ next_important_date | time_tag: format: 'date' }}</strong>
      </div>
    {% endif %}
  </div>

  {% if portal_has_content %}
    <div class="travel-portal-dashboard__grid">
      <article class="travel-portal-card travel-portal-card--hero">
        <p class="travel-portal-card__label">Overview</p>
        <h3 class="travel-portal-card__heading">
          {% if trip_name != blank %}
            {{ trip_name }}
          {% else %}
            Portal summary
          {% endif %}
        </h3>
        {% if portal_summary != blank %}
          <div class="travel-portal-card__copy rte">{{ portal_summary | newline_to_br }}</div>
        {% endif %}
        <div class="travel-portal-card__list">
          {% if trip_start_date != blank %}
            <p><strong>Start:</strong> {{ trip_start_date | time_tag: format: 'date' }}</p>
          {% endif %}
          {% if trip_end_date != blank %}
            <p><strong>End:</strong> {{ trip_end_date | time_tag: format: 'date' }}</p>
          {% endif %}
          {% if advisor_name != blank %}
            <p><strong>Advisor:</strong> {{ advisor_name }}</p>
          {% endif %}
        </div>
      </article>

      {% if ticket_summary != blank %}
        <article class="travel-portal-card">
          <p class="travel-portal-card__label">Tickets</p>
          <div class="travel-portal-card__copy rte">{{ ticket_summary | newline_to_br }}</div>
        </article>
      {% endif %}

      {% if hotel_summary != blank %}
        <article class="travel-portal-card">
          <p class="travel-portal-card__label">Hotel</p>
          <div class="travel-portal-card__copy rte">{{ hotel_summary | newline_to_br }}</div>
        </article>
      {% endif %}

      {% if important_dates != blank %}
        <article class="travel-portal-card">
          <p class="travel-portal-card__label">Important dates</p>
          <div class="travel-portal-card__copy rte">{{ important_dates | newline_to_br }}</div>
        </article>
      {% endif %}

      {% if documents_links != blank %}
        <article class="travel-portal-card">
          <p class="travel-portal-card__label">Documents and links</p>
          <div class="travel-portal-card__copy rte">{{ documents_links | newline_to_br }}</div>
        </article>
      {% endif %}

      {% if advisor_notes != blank %}
        <article class="travel-portal-card">
          <p class="travel-portal-card__label">Advisor notes</p>
          <div class="travel-portal-card__copy rte">{{ advisor_notes | newline_to_br }}</div>
        </article>
      {% endif %}

      {% if support_email != blank or support_phone != blank %}
        <article class="travel-portal-card">
          <p class="travel-portal-card__label">Support</p>
          <div class="travel-portal-card__list">
            {% if support_email != blank %}
              <p><strong>Email:</strong> <a href="mailto:{{ support_email }}">{{ support_email }}</a></p>
            {% endif %}
            {% if support_phone != blank %}
              <p><strong>Phone:</strong> <a href="tel:{{ support_phone | replace: ' ', '' }}">{{ support_phone }}</a></p>
            {% endif %}
          </div>
        </article>
      {% endif %}
    </div>
  {% else %}
    <div class="travel-portal-dashboard__empty" role="status">
      <h3>Your portal is not ready yet</h3>
      <p>We found your customer login, but there is no portal content assigned to this account yet.</p>
      {% if support_email != blank %}
        <p>Need help? Contact <a href="mailto:{{ support_email }}">{{ support_email }}</a>.</p>
      {% endif %}
    </div>
  {% endif %}
</section>
